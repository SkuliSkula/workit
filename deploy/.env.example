# Copy this file to .env and fill in your values before running docker compose.
# Never commit .env to git.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=workit
POSTGRES_USER=workit
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long random string — at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-very-long-random-signing-key-here

# ── Initial admin account ────────────────────────────────────────────────────
# Used once on first boot to create the super-admin user.
ADMIN_EMAIL=admin@workit.is
ADMIN_PASSWORD=change-me-strong-admin-password


# ── Job attachments (Cloudflare R2, optional) ─────────────────────────────────
# S3-compatible object storage for photos/PDFs uploaded to jobs.
# Leave blank to use the API's on-disk fallback (not durable across redeploys).
# ServiceUrl is your account endpoint: https://<accountid>.r2.cloudflarestorage.com
R2_SERVICE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
