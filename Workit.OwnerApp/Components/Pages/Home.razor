@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthSessionService AuthSession
@inject BusyService Busy
@inject NavigationManager Navigation
@inject ICompanyApi CompanyApi
@inject ICustomersApi CustomersApi
@inject IEmployeesApi EmployeesApi
@inject IJobsApi JobsApi
@inject ITimeEntriesApi TimeEntriesApi
@inject IMaterialsApi MaterialsApi
@inject IAbsenceApi AbsenceApi
@inject IPayrollApi PayrollApi
@inject IAuthApi AuthApi
@inject IPaydayInvoicesApi PaydayInvoicesApi
@using Workit.Shared.Utilities

<PageTitle>Home</PageTitle>

@if (adminNeedsCompany)
{
    <FluentCard Class="dashboard-shell">
        <FluentLabel Typo="Typography.PaneHeader">Welcome, Admin</FluentLabel>
        <p>Select a company to open it, or go to the Admin page to register a new one.</p>
        <div class="dashboard-actions" style="margin-bottom:1rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="@(() => Navigation.NavigateTo("/admin"))">Manage Companies</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" @onclick="LogoutAsync">Logout</FluentButton>
        </div>

        @if (userCompanies.Count > 0)
        {
            <FluentLabel Typo="Typography.Body" Style="font-weight:700; margin-bottom:0.5rem;">Enter a company:</FluentLabel>
            <div style="display:grid; gap:0.5rem; max-width:500px;">
                @foreach (var c in userCompanies)
                {
                    <button type="button" class="switch-company-item" @onclick="@(() => SwitchToCompanyAsync(c.Id))">
                        <div class="switch-company-info">
                            <span class="switch-company-name">@c.Name</span>
                            <span class="switch-company-detail">@c.Ssn · @c.Email</span>
                        </div>
                    </button>
                }
            </div>
        }
        else
        {
            <p style="color:#60758b;">No companies registered yet. Go to Admin to create one.</p>
        }
    </FluentCard>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <FluentCard Class="dashboard-shell">
        <FluentLabel Typo="Typography.PaneHeader">Home unavailable</FluentLabel>
        <p>@loadError</p>
        <div class="dashboard-actions">
            <FluentButton Appearance="Appearance.Accent" @onclick="RetryOrLoginAsync">Retry</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => Navigation.NavigateTo("/login"))">Login</FluentButton>
        </div>
    </FluentCard>
}
else if (isLoading)
{
    <FluentCard Class="dashboard-shell">
        <FluentLabel Typo="Typography.PaneHeader">Getting today ready…</FluentLabel>
    </FluentCard>
}
else if (!isOwnerSession)
{
    <FluentCard Class="dashboard-shell">
        <FluentLabel Typo="Typography.PaneHeader">Access restricted</FluentLabel>
        <p>The owner home page is available for owner accounts.</p>
        <div class="dashboard-actions">
            <FluentButton Appearance="Appearance.Stealth" @onclick="LogoutAsync">Logout</FluentButton>
        </div>
    </FluentCard>
}
else
{
    <section class="dashboard today">
        @if (isAdminSession)
        {
            <FluentCard Class="dashboard-shell" Style="background:#eff6ff; border:1px solid #93c5fd;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
                    <FluentLabel Style="font-weight:700; color:#1e40af;">
                        <FluentIcon Value="new Size24.Shield()" Style="vertical-align:middle;" /> Admin viewing: @(company?.Name ?? "Unknown")
                    </FluentLabel>
                    <div style="display:flex; gap:0.5rem;">
                        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" @onclick="@(() => Navigation.NavigateTo("/admin"))">Manage Companies</FluentButton>
                        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" @onclick="OpenSwitchCompanyDialog">Switch Company</FluentButton>
                    </div>
                </div>
            </FluentCard>
        }

        @* ── Today ── *@
        <FluentCard Class="dashboard-shell today-hero">
            <div class="today-hero-copy">
                <span class="eyebrow">@today.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMMM")</span>
                <h1>@Greeting@(string.IsNullOrEmpty(FirstName) ? "" : $", {FirstName}")</h1>
                <p>@HeroLine</p>
            </div>
            <div class="today-actions">
                @if (userCompanies.Count > 1)
                {
                    <FluentButton Appearance="Appearance.Stealth" @onclick="OpenSwitchCompanyDialog">
                        <FluentIcon Value="new Size24.ArrowSwap()" /> Switch company
                    </FluentButton>
                }
                <FluentButton Appearance="Appearance.Outline" @onclick="@(() => Navigation.NavigateTo("/jobs"))">Jobs</FluentButton>
                @if (company?.HasPaydayCredentials == true)
                {
                    <FluentButton Appearance="Appearance.Outline" @onclick="@(() => Navigation.NavigateTo("/payday/invoice-builder"))">Invoice builder</FluentButton>
                }
                <FluentButton Appearance="Appearance.Accent" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">Monthly dashboard</FluentButton>
            </div>
        </FluentCard>

        <section class="today-kpis">
            <a class="today-kpi" href="/timeentries">
                <span class="kpi-label">Hours today</span>
                <strong>@HoursOn(today).ToString("0.##")</strong>
                <span class="kpi-foot">@CrewOn(today) @(CrewOn(today) == 1 ? "person" : "people") logged</span>
            </a>
            <a class="today-kpi" href="/timeentries">
                <span class="kpi-label">This week</span>
                <strong>@HoursThisWeek.ToString("0.##")</strong>
                <span class="kpi-foot">@HoursLastWeekSoFar.ToString("0.##") h by this day last week</span>
            </a>
            <a class="today-kpi" href="@(company?.HasPaydayCredentials == true ? "/payday/invoice-builder" : "/timeentries")">
                <span class="kpi-label">Ready to invoice</span>
                <strong>@UninvoicedHours.ToString("0.##")<span class="kpi-unit"> h</span></strong>
                <span class="kpi-foot">on @toInvoice.Count @(toInvoice.Count == 1 ? "job" : "jobs")@(UninvoicedMaterialLines > 0 ? $" · {UninvoicedMaterialLines} material lines" : "")</span>
            </a>
            @if (paydayOutstanding is decimal outstanding)
            {
                <a class="today-kpi" href="/payday/invoices">
                    <span class="kpi-label">Outstanding</span>
                    <strong>@outstanding.ToString("N0")<span class="kpi-unit"> kr.</span></strong>
                    <span class="kpi-foot">@paydayOpenCount open @(paydayOpenCount == 1 ? "invoice" : "invoices")@(overdue.Count > 0 ? $" · {overdue.Count} overdue" : "")</span>
                </a>
            }
        </section>

        <div class="today-grid">
            @* ── Needs you ── *@
            <FluentCard Class="dashboard-shell">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Needs you</span>
                        <h2>@(ActionCount == 0 ? "All clear" : $"{ActionCount} {(ActionCount == 1 ? "thing" : "things")} to act on")</h2>
                    </div>
                </div>

                @if (ActionCount == 0)
                {
                    <p class="today-empty">Nothing is waiting on you — no requests to answer, nothing overdue, every crew member logged their day.</p>
                }

                @if (pendingAbsences.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--blue"></span>
                            <strong>Absence @(pendingAbsences.Count == 1 ? "request" : "requests") to answer</strong>
                            <a class="act-link" href="/absence">Absence →</a>
                        </div>
                        @foreach (var a in pendingAbsences)
                        {
                            <div class="act-row">
                                <div class="act-main">
                                    <span class="act-title">@EmployeeName(a.EmployeeId) · @AbsenceLabel(a.Type)</span>
                                    <span class="act-sub">@DateRange(a.StartDate, a.EndDate)@(a.HoursPerDay != 8m ? $" · {a.HoursPerDay:0.##} h/day" : "")@(string.IsNullOrWhiteSpace(a.Notes) ? "" : $" · “{a.Notes}”")</span>
                                </div>
                                <div class="act-buttons">
                                    <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" Disabled="@(reviewingId == a.Id)" @onclick="@(() => ReviewAsync(a, AbsenceStatus.Approved))">Approve</FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Disabled="@(reviewingId == a.Id)" @onclick="@(() => ReviewAsync(a, AbsenceStatus.Denied))">Deny</FluentButton>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(reviewError))
                        {
                            <p class="act-error">@reviewError</p>
                        }
                    </div>
                }

                @if (missingHours.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--amber"></span>
                            <strong>No hours logged for @DayName(lastWorkday)</strong>
                            <a class="act-link" href="/timeentries">Time entries →</a>
                        </div>
                        <div class="act-row">
                            <div class="act-main">
                                <span class="act-title">@string.Join(", ", missingHours.Select(e => e.DisplayName))</span>
                                <span class="act-sub">Logged hours in the last 30 days, nothing on @lastWorkday.ToString("d MMM") and no approved absence.</span>
                            </div>
                        </div>
                    </div>
                }

                @if (overdue.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--red"></span>
                            <strong>Overdue @(overdue.Count == 1 ? "invoice" : "invoices")</strong>
                            <a class="act-link" href="/payday/invoices">Invoices →</a>
                        </div>
                        @foreach (var i in overdue.Take(5))
                        {
                            <div class="act-row">
                                <div class="act-main">
                                    <span class="act-title">#@i.Number · @(i.Customer?.Name ?? "—")</span>
                                    <span class="act-sub">Due @i.DueDate?.ToString("d MMM") · @DaysOverdue(i) days overdue</span>
                                </div>
                                <span class="act-amount">@i.AmountIncludingVat.ToString("N0") kr.</span>
                            </div>
                        }
                        @if (overdue.Count > 5) { <p class="act-more">and @(overdue.Count - 5) more</p> }
                    </div>
                }

                @if (drafts.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--slate"></span>
                            <strong>@(drafts.Count == 1 ? "Draft" : "Drafts") not issued yet</strong>
                            <a class="act-link" href="/payday/invoices">Invoices →</a>
                        </div>
                        @foreach (var d in drafts.Take(5))
                        {
                            <div class="act-row">
                                <div class="act-main">
                                    <span class="act-title">@(d.Customer?.Name ?? "—")</span>
                                    <span class="act-sub">@(string.IsNullOrWhiteSpace(d.Description) ? "Draft" : d.Description) · made @d.Created?.ToString("d MMM")</span>
                                </div>
                                <span class="act-amount">@d.AmountIncludingVat.ToString("N0") kr.</span>
                            </div>
                        }
                        @if (drafts.Count > 5) { <p class="act-more">and @(drafts.Count - 5) more</p> }
                    </div>
                }

                @if (payrollDue is DateOnly payrollMonth)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--blue"></span>
                            <strong>@payrollMonth.ToDateTime(TimeOnly.MinValue).ToString("MMMM") payroll not sent to Payday</strong>
                            <a class="act-link" href="/payday/payroll">Payroll →</a>
                        </div>
                        <div class="act-row">
                            <div class="act-main">
                                <span class="act-sub">@HoursIn(payrollMonth).ToString("0.##") h logged that month by @CrewIn(payrollMonth) @(CrewIn(payrollMonth) == 1 ? "person" : "people").</span>
                            </div>
                        </div>
                    </div>
                }

                @if (toInvoice.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--green"></span>
                            <strong>Work ready to invoice</strong>
                            @if (company?.HasPaydayCredentials == true)
                            {
                                <a class="act-link" href="/payday/invoice-builder">Invoice builder →</a>
                            }
                        </div>
                        @foreach (var row in toInvoice.Take(5))
                        {
                            <a class="act-row act-row--link" href="/jobs/@row.Job.Id">
                                <div class="act-main">
                                    <span class="act-title">@row.Job.Code · @row.Job.Name</span>
                                    <span class="act-sub">@CustomerName(row.Job.CustomerId) · since @row.Oldest.ToString("d MMM")@(row.MaterialLines > 0 ? $" · {row.MaterialLines} material lines" : "")</span>
                                </div>
                                <span class="act-amount">@row.Hours.ToString("0.##") h</span>
                            </a>
                        }
                        @if (toInvoice.Count > 5) { <p class="act-more">and @(toInvoice.Count - 5) more jobs</p> }
                    </div>
                }

                @if (waitingJobs.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--amber"></span>
                            <strong>@(waitingJobs.Count == 1 ? "Job" : "Jobs") on hold</strong>
                            <a class="act-link" href="/kanban">Kanban →</a>
                        </div>
                        @foreach (var j in waitingJobs)
                        {
                            <a class="act-row act-row--link" href="/jobs/@j.Id">
                                <div class="act-main">
                                    <span class="act-title">@j.Code · @j.Name</span>
                                    <span class="act-sub">@(string.IsNullOrWhiteSpace(j.WaitingReason) ? "On hold" : j.WaitingReason)@(j.KanbanWaitingAt is DateTimeOffset since ? $" · {(int)(DateTimeOffset.UtcNow - since).TotalDays} days" : "")</span>
                                </div>
                            </a>
                        }
                    </div>
                }

                @if (unassignedJobs.Count > 0)
                {
                    <div class="act">
                        <div class="act-head">
                            <span class="act-dot act-dot--slate"></span>
                            <strong>@(unassignedJobs.Count == 1 ? "Job" : "Jobs") nobody is assigned to</strong>
                            <a class="act-link" href="/jobs">Jobs →</a>
                        </div>
                        @foreach (var j in unassignedJobs.Take(5))
                        {
                            <a class="act-row act-row--link" href="/jobs/@j.Id">
                                <div class="act-main">
                                    <span class="act-title">@j.Code · @j.Name</span>
                                    <span class="act-sub">The crew can't see it in their apps until someone is assigned.</span>
                                </div>
                            </a>
                        }
                        @if (unassignedJobs.Count > 5) { <p class="act-more">and @(unassignedJobs.Count - 5) more</p> }
                    </div>
                }
            </FluentCard>

            @* ── Latest work ── *@
            <FluentCard Class="dashboard-shell">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Latest work</span>
                        <h2>From the crew</h2>
                    </div>
                    <a class="act-link" href="/timeentries">All time entries →</a>
                </div>

                @if (feed.Count == 0)
                {
                    <p class="today-empty">Nothing logged in the last 7 days.</p>
                }
                @foreach (var day in feed.GroupBy(f => f.Date))
                {
                    <div class="feed-day">
                        <span class="feed-day-name">@DayName(day.Key)</span>
                        <span class="feed-day-total">@day.Where(f => f.Hours is not null).Sum(f => f.Hours ?? 0).ToString("0.##") h</span>
                    </div>
                    @foreach (var item in day)
                    {
                        <a class="feed-row" href="@(item.JobId is Guid jobId ? $"/jobs/{jobId}" : "/timeentries")">
                            <span class="feed-who">@item.Who</span>
                            <span class="feed-what">
                                <span class="feed-job">@item.Job</span>
                                @if (!string.IsNullOrWhiteSpace(item.Note)) { <span class="feed-note">@item.Note</span> }
                            </span>
                            <span class="feed-amount @(item.Hours is null ? "feed-amount--material" : "")">@item.Amount</span>
                        </a>
                    }
                }
            </FluentCard>
        </div>
    </section>
}

@* ── Switch Company Dialog ── *@
@if (showSwitchDialog)
{
    <div class="switch-overlay" @onclick="CloseSwitchCompanyDialog">
        <div class="switch-dialog" @onclick:stopPropagation="true">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                <h3 style="margin:0; color:#14304b;">Switch Company</h3>
                <FluentButton Appearance="Appearance.Stealth" @onclick="CloseSwitchCompanyDialog">✕</FluentButton>
            </div>

            @if (!string.IsNullOrWhiteSpace(switchError))
            {
                <div style="color:#dc2626; font-size:0.85rem; margin-bottom:0.75rem;">@switchError</div>
            }

            <div class="switch-company-list">
                @foreach (var c in userCompanies)
                {
                    var isCurrent = c.Id == session?.CompanyId;
                    <button type="button"
                            class="switch-company-item @(isCurrent ? "switch-company-item--current" : "")"
                            disabled="@(isCurrent || isSwitching)"
                            @onclick="@(() => SwitchToCompanyAsync(c.Id))">
                        <div class="switch-company-info">
                            <span class="switch-company-name">@c.Name</span>
                            <span class="switch-company-detail">@c.Ssn · @c.Email</span>
                        </div>
                        @if (isCurrent)
                        {
                            <span class="switch-company-badge">Current</span>
                        }
                        else if (isSwitching && switchingToCompanyId == c.Id)
                        {
                            <span class="switch-company-badge switch-company-badge--loading">Switching…</span>
                        }
                    </button>
                }
            </div>

            <div style="margin-top:1rem; padding-top:0.75rem; border-top:1px solid #e5e7eb;">
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToCreateCompany" Style="width:100%;">
                    <FluentIcon Value="new Size24.Add()" /> Add New Company
                </FluentButton>
            </div>
        </div>
    </div>
}

@code {
    private LoginResponse? session;
    private Company? company;
    private bool isLoading = true;
    private string? loadError;

    // Admin / switch company state
    private bool adminNeedsCompany;
    private List<Company> userCompanies = [];
    private bool showSwitchDialog;
    private bool isSwitching;
    private Guid? switchingToCompanyId;
    private string? switchError;

    private bool isOwnerSession => string.Equals(session?.Role, WorkitRoles.Owner, StringComparison.Ordinal)
                                  || string.Equals(session?.Role, WorkitRoles.Admin, StringComparison.Ordinal);
    private bool isAdminSession => string.Equals(session?.Role, WorkitRoles.Admin, StringComparison.Ordinal);

    // ── What the page is built from ──────────────────────────────────────────
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly lastWorkday;
    private List<Customer> customers = [];
    private List<Employee> employees = [];
    private List<Job> jobs = [];
    private List<TimeEntry> entries = [];
    private List<MaterialUsage> usages = [];
    private Dictionary<Guid, string> materialNames = [];

    // ── Needs you ────────────────────────────────────────────────────────────
    private List<AbsenceRequest> pendingAbsences = [];
    private List<Employee> missingHours = [];
    private List<PaydayInvoice> overdue = [];
    private List<PaydayInvoice> drafts = [];
    private DateOnly? payrollDue;
    private List<InvoiceRow> toInvoice = [];
    private List<Job> waitingJobs = [];
    private List<Job> unassignedJobs = [];
    private decimal? paydayOutstanding;
    private int paydayOpenCount;
    private Guid? reviewingId;
    private string? reviewError;

    private List<FeedItem> feed = [];

    /// <summary>Things the owner can act on; work ready to invoice counts once, however many jobs.</summary>
    private int ActionCount =>
        pendingAbsences.Count + (missingHours.Count > 0 ? 1 : 0) + overdue.Count + drafts.Count
        + (payrollDue is null ? 0 : 1) + (toInvoice.Count > 0 ? 1 : 0) + waitingJobs.Count + unassignedJobs.Count;

    private string Greeting => DateTime.Now.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };
    /// <summary>The owner's own employee record names them; the company's owner field otherwise.</summary>
    private string FirstName =>
        ((employees.FirstOrDefault(e => e.Id == session?.EmployeeId)?.DisplayName ?? company?.Owner ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()) ?? "";
    private string HeroLine
    {
        get
        {
            var crew = CrewOn(today);
            var hours = HoursOn(today);
            return crew == 0
                ? $"No hours logged yet today. {DayName(lastWorkday)} the crew logged {HoursOn(lastWorkday):0.##} h."
                : $"{crew} {(crew == 1 ? "person has" : "people have")} logged {hours:0.##} h today.";
        }
    }

    private decimal HoursOn(DateOnly day) => entries.Where(e => e.WorkDate == day).Sum(e => e.Hours + e.OvertimeHours);
    private int CrewOn(DateOnly day) => entries.Where(e => e.WorkDate == day).Select(e => e.EmployeeId).Distinct().Count();
    private DateOnly WeekStart(DateOnly day) => day.AddDays(-(((int)day.DayOfWeek + 6) % 7));
    private decimal HoursThisWeek => entries.Where(e => e.WorkDate >= WeekStart(today) && e.WorkDate <= today).Sum(e => e.Hours + e.OvertimeHours);
    private decimal HoursLastWeekSoFar
    {
        get
        {
            var start = WeekStart(today).AddDays(-7);
            var end = today.AddDays(-7);
            return entries.Where(e => e.WorkDate >= start && e.WorkDate <= end).Sum(e => e.Hours + e.OvertimeHours);
        }
    }
    private decimal UninvoicedHours => toInvoice.Sum(r => r.Hours);
    private int UninvoicedMaterialLines => toInvoice.Sum(r => r.MaterialLines);
    private decimal HoursIn(DateOnly month) => entries.Where(e => e.WorkDate.Year == month.Year && e.WorkDate.Month == month.Month).Sum(e => e.Hours + e.OvertimeHours);
    private int CrewIn(DateOnly month) => entries.Where(e => e.WorkDate.Year == month.Year && e.WorkDate.Month == month.Month).Select(e => e.EmployeeId).Distinct().Count();

    private string EmployeeName(Guid id) => employees.FirstOrDefault(e => e.Id == id)?.DisplayName ?? "Someone";
    private string CustomerName(Guid id) => customers.FirstOrDefault(c => c.Id == id)?.Name ?? "—";
    private int DaysOverdue(PaydayInvoice i) => i.DueDate is DateTime due ? Math.Max(0, today.DayNumber - DateOnly.FromDateTime(due).DayNumber) : 0;

    private string DayName(DateOnly day) =>
        day == today ? "Today" :
        day == today.AddDays(-1) ? "Yesterday" :
        day.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMM");

    private static string DateRange(DateOnly from, DateOnly to) =>
        from == to ? from.ToString("d MMM") : $"{from:d MMM} – {to:d MMM} ({to.DayNumber - from.DayNumber + 1} days)";

    private static string AbsenceLabel(AbsenceType type) => type switch
    {
        AbsenceType.Vacation       => "Vacation",
        AbsenceType.SickLeave      => "Sick leave",
        AbsenceType.ParentalLeave  => "Parental leave",
        AbsenceType.PersonalLeave  => "Personal leave",
        AbsenceType.Bereavement    => "Bereavement",
        AbsenceType.UnpaidLeave    => "Unpaid leave",
        AbsenceType.PublicHoliday  => "Public holiday",
        AbsenceType.WorkInjury     => "Work injury",
        AbsenceType.UnionLeave     => "Union leave",
        AbsenceType.StudyLeave     => "Study leave",
        AbsenceType.SickChildLeave => "Sick child",
        _                          => type.ToString(),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            session = await AuthSession.GetSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            if (!isOwnerSession) return;

            if (isAdminSession)
            {
                var adminCompanies = await AuthApi.GetUserCompaniesAsync();
                userCompanies = adminCompanies.IsSuccess && adminCompanies.Value is not null ? adminCompanies.Value : [];
            }

            var companyResult = await CompanyApi.GetCompanyAsync();
            if (!companyResult.IsSuccess || companyResult.Value is null)
            {
                if (isAdminSession) { adminNeedsCompany = true; return; }
                if (IsUnauthorized(companyResult.ErrorMessage))
                {
                    await AuthSession.LogoutAsync();
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
                loadError = companyResult.ErrorMessage ?? "The company profile could not be loaded right now.";
                return;
            }
            company = companyResult.Value;

            var companiesResult = await AuthApi.GetUserCompaniesAsync();
            userCompanies = companiesResult.IsSuccess && companiesResult.Value is not null ? companiesResult.Value : [company];

            lastWorkday = PreviousWorkday(today);

            // Everything at once; Payday's half (stored in Workit) only for a connected company.
            var customersTask = CustomersApi.GetCustomersAsync();
            var employeesTask = EmployeesApi.GetEmployeesAsync();
            var jobsTask      = JobsApi.GetJobsAsync();
            var entriesTask   = TimeEntriesApi.GetTimeEntriesAsync();
            var usagesTask    = MaterialsApi.GetMaterialUsageAsync();
            var materialsTask = MaterialsApi.GetMaterialsAsync();
            var pendingTask   = AbsenceApi.GetAbsencesAsync(status: AbsenceStatus.Pending);
            var awayTask      = AbsenceApi.GetAbsencesAsync(from: lastWorkday, to: lastWorkday, status: AbsenceStatus.Approved);
            await Task.WhenAll(customersTask, employeesTask, jobsTask, entriesTask, usagesTask, materialsTask, pendingTask, awayTask);

            var error = (await jobsTask).ErrorMessage ?? (await entriesTask).ErrorMessage ?? (await employeesTask).ErrorMessage;
            if (!(await jobsTask).IsSuccess || !(await entriesTask).IsSuccess || !(await employeesTask).IsSuccess)
            {
                if (IsUnauthorized(error))
                {
                    await AuthSession.LogoutAsync();
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
                loadError = error ?? "Today's overview could not be loaded.";
                return;
            }

            customers = (await customersTask).Value ?? [];
            employees = (await employeesTask).Value ?? [];
            jobs      = (await jobsTask).Value ?? [];
            entries   = (await entriesTask).Value ?? [];
            usages    = (await usagesTask).Value ?? [];
            materialNames = ((await materialsTask).Value ?? []).ToDictionary(m => m.Id, m => m.Name);
            pendingAbsences = ((await pendingTask).Value ?? []).OrderBy(a => a.StartDate).ToList();
            var away = ((await awayTask).Value ?? []).Select(a => a.EmployeeId).ToHashSet();

            BuildNeedsYou(away);
            BuildFeed();

            if (company.HasPaydayCredentials)
                await LoadPaydayAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildNeedsYou(HashSet<Guid> awayOnLastWorkday)
    {
        // Crew who have been logging hours lately but logged nothing on the last
        // working day — the ones worth a nudge. Office staff and the owner, who
        // never log, never show.
        var recent = entries.Where(e => e.WorkDate > today.AddDays(-30)).Select(e => e.EmployeeId).ToHashSet();
        var loggedThen = entries.Where(e => e.WorkDate == lastWorkday).Select(e => e.EmployeeId).ToHashSet();
        missingHours = employees
            .Where(e => e.IsActive && recent.Contains(e.Id) && !loggedThen.Contains(e.Id) && !awayOnLastWorkday.Contains(e.Id))
            .OrderBy(e => e.DisplayName)
            .ToList();

        var entriesByJob = entries.GroupBy(e => e.JobId).ToDictionary(g => g.Key, g => g.ToList());
        var lanes = jobs.ToDictionary(j => j.Id, j => JobLanes.Of(j, entriesByJob.GetValueOrDefault(j.Id) ?? []));

        waitingJobs = jobs.Where(j => lanes[j.Id] == JobLane.Waiting)
            .OrderBy(j => j.KanbanWaitingAt ?? DateTimeOffset.MaxValue).ToList();
        unassignedJobs = jobs.Where(j => lanes[j.Id] != JobLane.Done && j.AssignedEmployeeIds.Count == 0)
            .OrderByDescending(j => j.JobNumber).ToList();

        var openUsages = usages.Where(u => !u.IsInvoiced && u.JobId is not null).GroupBy(u => u.JobId!.Value).ToDictionary(g => g.Key, g => g.ToList());
        toInvoice = jobs
            .Select(j =>
            {
                var open = (entriesByJob.GetValueOrDefault(j.Id) ?? []).Where(e => !e.IsInvoiced).ToList();
                var mats = openUsages.GetValueOrDefault(j.Id) ?? [];
                if (open.Count == 0 && mats.Count == 0) return null;
                var oldest = open.Select(e => e.WorkDate)
                    .Concat(mats.Select(u => DateOnly.FromDateTime(u.UsedAt.LocalDateTime)))
                    .Min();
                return new InvoiceRow(j, open.Sum(e => e.Hours + e.OvertimeHours), mats.Count, oldest);
            })
            .OfType<InvoiceRow>()
            .OrderBy(r => r.Oldest)
            .ToList();
    }

    private void BuildFeed()
    {
        var since = today.AddDays(-6);
        var jobLabel = jobs.ToDictionary(j => j.Id, j => $"{j.Code} · {j.Name}");
        var hours = entries.Where(e => e.WorkDate >= since).Select(e => new FeedItem(
            e.WorkDate,
            e.CreatedAt ?? e.WorkDate.ToDateTime(TimeOnly.MinValue),
            EmployeeName(e.EmployeeId),
            jobLabel.GetValueOrDefault(e.JobId, "Unknown job"),
            e.JobId,
            e.Notes,
            e.Hours + e.OvertimeHours,
            e.OvertimeHours > 0 ? $"{e.Hours + e.OvertimeHours:0.##} h ({e.OvertimeHours:0.##} OT)" : $"{e.Hours:0.##} h"));
        var materials = usages.Where(u => DateOnly.FromDateTime(u.UsedAt.LocalDateTime) >= since).Select(u => new FeedItem(
            DateOnly.FromDateTime(u.UsedAt.LocalDateTime),
            u.UsedAt,
            EmployeeName(u.EmployeeId),
            u.JobId is Guid id ? jobLabel.GetValueOrDefault(id, "Unknown job") : "No job",
            u.JobId,
            materialNames.GetValueOrDefault(u.MaterialId, "Material") + (string.IsNullOrWhiteSpace(u.Notes) ? "" : $" — {u.Notes}"),
            null,
            $"{u.Quantity:0.##} ×"));
        feed = hours.Concat(materials)
            .OrderByDescending(f => f.Date).ThenByDescending(f => f.At)
            .Take(40)
            .ToList();
    }

    /// <summary>Invoices are Workit's stored copy of Payday's (refreshed every 30 minutes), so this is quick.</summary>
    private async Task LoadPaydayAsync()
    {
        var openTask   = PaydayInvoicesApi.GetAllAsync(page: 1, perPage: 200, include: null, excludeStatus: "DRAFT,CANCELLED,PAID,CREDIT,DELETED", order: "asc", orderBy: "dueDate");
        var draftsTask = PaydayInvoicesApi.GetAllAsync(page: 1, perPage: 50, include: null, excludeStatus: "SENT,CANCELLED,PAID,CREDIT,DELETED");
        var payrollTask = PayrollApi.GetExportsAsync();
        await Task.WhenAll(openTask, draftsTask, payrollTask);

        if ((await openTask) is { IsSuccess: true, Value: { } open })
        {
            paydayOutstanding = open.Summary?.UnpaidAmount;
            paydayOpenCount   = open.Summary?.TotalCount ?? open.Total;
            overdue = open.Invoices.Where(i => i.DueDate is DateTime due && DateOnly.FromDateTime(due) < today).ToList();
        }
        if ((await draftsTask) is { IsSuccess: true, Value: { } d })
            drafts = d.Invoices;

        // Early in the month, last month's hours should be on their way to Payday.
        var lastMonth = new DateOnly(today.Year, today.Month, 1).AddMonths(-1);
        if (today.Day <= 15 && HoursIn(lastMonth) > 0 && (await payrollTask) is { IsSuccess: true, Value: { } exports }
            && !exports.Any(x => x.Year == lastMonth.Year && x.Month == lastMonth.Month))
            payrollDue = lastMonth;
    }

    private async Task ReviewAsync(AbsenceRequest absence, AbsenceStatus status)
    {
        reviewingId = absence.Id;
        reviewError = null;
        var result = await AbsenceApi.ReviewAbsenceAsync(absence.Id, status);
        if (result.IsSuccess) pendingAbsences.Remove(absence);
        else reviewError = result.ErrorMessage ?? "The request could not be answered right now.";
        reviewingId = null;
    }

    /// <summary>The working day before <paramref name="day"/>: not a weekend, not a full public holiday.</summary>
    private static DateOnly PreviousWorkday(DateOnly day)
    {
        var d = day.AddDays(-1);
        for (var i = 0; i < 14; i++, d = d.AddDays(-1))
        {
            if (d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday) continue;
            if (IcelandicHolidays.GetHolidaysInMonth(d.Year, d.Month).Any(h => h.Date == d && !h.IsHalfDay)) continue;
            return d;
        }
        return day.AddDays(-1);
    }

    private async Task RetryOrLoginAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private static bool IsUnauthorized(string? errorMessage) =>
        !string.IsNullOrWhiteSpace(errorMessage) &&
        (errorMessage.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase) ||
         errorMessage.Contains("401", StringComparison.OrdinalIgnoreCase));

    private void OpenSwitchCompanyDialog()
    {
        switchError = null;
        showSwitchDialog = true;
    }

    private void CloseSwitchCompanyDialog() => showSwitchDialog = false;

    private async Task SwitchToCompanyAsync(Guid companyId)
    {
        using var busy = Busy.Begin("Switching company…");
        isSwitching = true;
        switchingToCompanyId = companyId;
        switchError = null;

        var result = await AuthSession.SwitchCompanyAsync(companyId);
        if (result.IsSuccess)
        {
            showSwitchDialog = false;
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            switchError = result.ErrorMessage ?? "Failed to switch company.";
        }

        isSwitching = false;
        switchingToCompanyId = null;
    }

    private void NavigateToCreateCompany()
    {
        showSwitchDialog = false;
        Navigation.NavigateTo("/companies/new");
    }

    private async Task LogoutAsync()
    {
        await AuthSession.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed record InvoiceRow(Job Job, decimal Hours, int MaterialLines, DateOnly Oldest);
    /// <summary>One line of the latest-work feed: hours (Hours set) or a material logged (Hours null).</summary>
    private sealed record FeedItem(DateOnly Date, DateTimeOffset At, string Who, string Job, Guid? JobId, string Note, decimal? Hours, string Amount);
