@page "/jobs"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICompanyApi CompanyApi
@inject ICustomersApi CustomersApi
@inject IJobsApi JobsApi
@inject IJobTasksApi JobTasksApi
@inject IEmployeesApi EmployeesApi
@inject ITimeEntriesApi TimeEntriesApi
@inject IMaterialsApi MaterialsApi
@inject NavigationManager Nav
@inject BusyService Busy

<PageTitle>Jobs</PageTitle>

@* ── Header ── *@
<FluentCard Class="admin-card" AreaRestricted="false">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <FluentLabel Typo="Typography.PaneHeader">Jobs</FluentLabel>
        @if (company is not null)
        {
            <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                <FluentLabel style="white-space:nowrap; font-size:0.85rem;">Driving rate</FluentLabel>
                <FluentNumberField TValue="decimal" @bind-Value="drivingUnitPrice" Min="0" Step="1" style="width:100px;" />
                <FluentLabel style="white-space:nowrap; font-size:0.85rem;">Standard hours/day</FluentLabel>
                <FluentNumberField TValue="decimal" @bind-Value="standardHoursPerDay" Min="1" Max="24" Step="0.5" style="width:100px;" />
                <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" @onclick="SaveCompanySettingsAsync" Disabled="@savingSettings">
                    @(savingSettings ? "…" : "Save")
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="ToggleCreateForm">
                    @(showCreateForm ? "✕ Cancel" : "+ New")
                </FluentButton>
            </div>
        }
    </div>

    @if (company is null && !loading)
    {
        <FluentLabel style="margin-top:0.5rem;">Set up the company first in Admin before adding jobs.</FluentLabel>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@loadError</FluentLabel>
    }
    @if (!string.IsNullOrWhiteSpace(settingsError))
    {
        <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@settingsError</FluentLabel>
    }
</FluentCard>

@* ── Create form ── *@
@if (showCreateForm)
{
    <FluentCard Class="admin-card" AreaRestricted="false">
        <FluentLabel Typo="Typography.Body"><strong>New Job</strong></FluentLabel>
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div>
                @if (customers.Count > 0)
                {
                    <FluentSelect Label="Customer *" TValue="string" TOption="string" @bind-Value="selectedCustomerId" style="width:100%">
                        @foreach (var c in customers)
                        {
                            <FluentOption TOption="string" Value="@c.Id.ToString()">@c.Name</FluentOption>
                        }
                    </FluentSelect>
                }
                else { <FluentLabel>No customers available yet.</FluentLabel> }
            </div>
            <div>
                <EmployeeMultiSelect Employees="employees" @bind-SelectedIds="selectedEmployeeIds" />
            </div>
            <div>
                <FluentTextField Label="Job name *" @bind-Value="newJobName" Placeholder="e.g. Electrical installation" style="width:100%" />
            </div>
            <div>
                <FluentSelect Label="Category *" TValue="string" TOption="string"
                              Value="@newCategory.ToString()"
                              ValueChanged="@(v => newCategory = Enum.TryParse<JobCategory>(v, out var c) ? c : JobCategory.NewInstallation)"
                              style="width:100%">
                    <FluentOption TOption="string" Value="NewInstallation">New Installation</FluentOption>
                    <FluentOption TOption="string" Value="Repair">Repair</FluentOption>
                    <FluentOption TOption="string" Value="InnerWork">Inner Work</FluentOption>
                    <FluentOption TOption="string" Value="Drawings">Drawings</FluentOption>
                    <FluentOption TOption="string" Value="Offer">Offer</FluentOption>
                    <FluentOption TOption="string" Value="Maintenance">Maintenance</FluentOption>
                    <FluentOption TOption="string" Value="Inspection">Inspection</FluentOption>
                    <FluentOption TOption="string" Value="Consultation">Consultation</FluentOption>
                </FluentSelect>
            </div>
            <div>
                <FluentSelect Label="Billing type" TValue="string" TOption="string"
                              Value="@newBillingType.ToString()"
                              ValueChanged="@(v => newBillingType = Enum.TryParse<BillingType>(v, out var b) ? b : BillingType.Hourly)"
                              style="width:100%">
                    <FluentOption TOption="string" Value="Hourly">Hourly</FluentOption>
                    <FluentOption TOption="string" Value="FixedPrice">Fixed price</FluentOption>
                </FluentSelect>
            </div>
        </div>
        @if (SelectedCustomerPlansTasks)
        {
            <div class="first-tasks">
                <div class="job-section-title" style="margin-top:0.25rem;">First tasks</div>
                <p class="job-empty-note" style="margin:0 0 0.5rem 0;">This customer's jobs are planned in tasks. Add the first ones now, or later from the job.</p>
                @for (var i = 0; i < newTasks.Count; i++)
                {
                    var row = newTasks[i];
                    <div class="first-task-row">
                        <FluentTextField @bind-Value="row.Name" Placeholder="Task name" style="flex:1;" />
                        <FluentNumberField TValue="decimal?" @bind-Value="row.EstimatedHours" Placeholder="h" Min="0" Step="0.5" style="width:6rem;" />
                        <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => newTasks.Remove(row))" title="Remove">✕</FluentButton>
                    </div>
                }
                <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => newTasks.Add(new NewTaskRow()))">+ Add a task</FluentButton>
            </div>
        }
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="CreateJobAsync"
                          Disabled="@(!HasSelectedCustomer)">Save</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="ToggleCreateForm">Cancel</FluentButton>
        </div>
    </FluentCard>
}

@* ── Job accordion list ── *@
@if (loading)
{
    <PageLoader />
}
else if (jobs.Count > 0)
{
    <div class="jobs-panel">
        <div class="jobs-panel-header">
            <span class="jobs-panel-title">All jobs</span>
            <span class="jobs-count">@jobs.Count</span>
        </div>
        @foreach (var job in jobs)
        {
            var isExpanded = expandedJobId == job.Id;
            var isEditing  = editingJob?.Id == job.Id;
            var details    = jobDetails.GetValueOrDefault(job.Id);

            <div class="job-card @(isExpanded ? "job-card--open" : "")">

                @* ── Always-visible header ── *@
                <button class="job-card-header" @onclick="@(() => ToggleJobAsync(job))">
                    <svg class="job-chevron @(isExpanded ? "job-chevron--open" : "")" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span class="job-code">@job.Code</span>
                    <span class="job-name">@job.Name</span>
                    <span class="job-customer">@customerLookup.GetValueOrDefault(job.CustomerId, "—")</span>
                    @if (job.AssignedEmployeeIds.Count > 0)
                    {
                        <span class="job-assignee" title="@AssigneeNames(job, all: true)">@AssigneeNames(job, all: false)</span>
                    }
                    <span class="job-billing-badge badge--category">@CategoryLabel(job.Category)</span>
                    <span class="job-billing-badge @(job.BillingType == BillingType.Hourly ? "badge--hourly" : "badge--fixed")">
                        @(job.BillingType == BillingType.Hourly ? "Hourly" : "Fixed price")
                    </span>
                    @{ var headerTasks = TasksFor(job.Id); }
                    @if (headerTasks.Count > 0)
                    {
                        var open = headerTasks.Count(t => t.Status == JobTaskStatus.Open);
                        <span class="job-billing-badge badge--tasks" title="@open open of @headerTasks.Count tasks">
                            @{ var noun = headerTasks.Count == 1 ? "task" : "tasks"; }
                            @(open == 0 ? $"{headerTasks.Count} {noun} · all done" : $"{headerTasks.Count} {noun} · {open} open")
                        </span>
                    }
                    @if (details is not null && !string.IsNullOrEmpty(details.InvoiceStatusLabel))
                    {
                        var fullyInv = details.InvoiceStatusLabel == "Fully invoiced";
                        <span style="font-size:0.7rem; font-weight:600; padding:2px 6px; border-radius:4px;
                                     background:@(fullyInv ? "#dcfce7" : "#fef3c7");
                                     color:@(fullyInv ? "#166534" : "#92400e");">
                            @(fullyInv ? "Invoiced" : "Partial")
                            @if (details.InvoiceNumbers.Count > 0)
                            {
                                <text> #@string.Join(", #", details.InvoiceNumbers)</text>
                            }
                        </span>
                    }
                </button>

                @* ── Expanded detail ── *@
                @if (isExpanded)
                {
                    @if (details is null)
                    {
                        <div class="job-loading">Loading details…</div>
                    }
                    else
                    {
                        <div class="job-detail">

                            @* KPI bar *@
                            <div class="job-kpis">
                                <div class="job-kpi">
                                    <span class="job-kpi-val">@details.TotalHours.ToString("0.#")</span>
                                    <span class="job-kpi-lbl">hours</span>
                                </div>
                                @if (details.TotalOvertimeHours > 0)
                                {
                                    <div class="job-kpi job-kpi--ot">
                                        <span class="job-kpi-val">@details.TotalOvertimeHours.ToString("0.#")</span>
                                        <span class="job-kpi-lbl">OT hours</span>
                                    </div>
                                }
                                <div class="job-kpi">
                                    <span class="job-kpi-val">@details.WorkerCount</span>
                                    <span class="job-kpi-lbl">worker@(details.WorkerCount == 1 ? "" : "s")</span>
                                </div>
                                <div class="job-kpi">
                                    <span class="job-kpi-val">@details.EntryCount</span>
                                    <span class="job-kpi-lbl">time entr@(details.EntryCount == 1 ? "y" : "ies")</span>
                                </div>
                                @if (details.TotalDrivingUnits > 0)
                                {
                                    <div class="job-kpi job-kpi--driving">
                                        <span class="job-kpi-val">@details.TotalDrivingUnits</span>
                                        <span class="job-kpi-lbl">driving unit@(details.TotalDrivingUnits == 1 ? "" : "s")@(drivingUnitPrice > 0 ? $" · {(details.TotalDrivingUnits * drivingUnitPrice).ToString("N0")} kr." : "")</span>
                                    </div>
                                }
                                @if (details.MaterialCostExVat > 0)
                                {
                                    <div class="job-kpi job-kpi--materials">
                                        <span class="job-kpi-val">@details.MaterialCostExVat.ToString("N0") kr.</span>
                                        <span class="job-kpi-lbl">materials (ex. VAT)</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(details.InvoiceStatusLabel))
                                {
                                    var isFullyInvoiced = details.InvoiceStatusLabel == "Fully invoiced";
                                    <div class="job-kpi" style="border-left:3px solid @(isFullyInvoiced ? "#10b981" : "#f59e0b"); padding-left:0.5rem;">
                                        <span class="job-kpi-val" style="font-size:0.85rem; color:@(isFullyInvoiced ? "#065f46" : "#92400e");">
                                            @details.InvoiceStatusLabel
                                        </span>
                                        <span class="job-kpi-lbl">
                                            @details.InvoicedEntryCount/@details.EntryCount entries
                                            @if (details.InvoiceNumbers.Count > 0)
                                            {
                                                <text> · #@string.Join(", #", details.InvoiceNumbers)</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>

                            @* Tasks — shown once the job has any, or when its customer plans jobs in tasks *@
                            @{
                                var jobTasks = TasksFor(job.Id);
                                var showTasks = jobTasks.Count > 0 || CustomerPlansTasks(job.CustomerId) || addingTaskForJob == job.Id;
                            }
                            @if (showTasks)
                            {
                                <div class="job-section-title">
                                    <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm7.7 8.7a1 1 0 00-1.4-1.4L9 12.6l-1.3-1.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Tasks
                                    @if (jobTasks.Count > 0)
                                    {
                                        <span class="job-tasks-count">@jobTasks.Count(t => t.Status == JobTaskStatus.Done) of @jobTasks.Count done</span>
                                    }
                                </div>

                                @if (jobTasks.Count == 0)
                                {
                                    <p class="job-empty-note">No tasks yet — add the first.</p>
                                }
                                else
                                {
                                    <div class="job-rows">
                                        @foreach (var task in jobTasks.OrderBy(t => t.Status).ThenBy(t => t.SortOrder).ThenBy(t => t.TaskNumber))
                                        {
                                            var logged = details.HoursByTask.GetValueOrDefault(task.Id);
                                            var over = task.EstimatedHours is decimal est && logged > est;
                                            @if (editingTask?.Id == task.Id)
                                            {
                                                <div class="job-task-edit">
                                                    <div class="admin-grid">
                                                        <div><FluentTextField Label="Name" @bind-Value="editingTask.Name" style="width:100%" /></div>
                                                        <div><FluentNumberField TValue="decimal?" Label="Estimate (h)" @bind-Value="editingTask.EstimatedHours" Min="0" Step="0.5" style="width:100%" /></div>
                                                        <div><EmployeeMultiSelect Label="Assigned" Employees="employees" @bind-SelectedIds="editingTaskEmployeeIds" /></div>
                                                        <div><FluentTextField Label="Description" @bind-Value="editingTask.Description" style="width:100%" /></div>
                                                    </div>
                                                    <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
                                                        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" @onclick="SaveTaskAsync" Disabled="@(savingTask || string.IsNullOrWhiteSpace(editingTask.Name))">@(savingTask ? "Saving…" : "Save")</FluentButton>
                                                        <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" @onclick="@(() => editingTask = null)" Disabled="@savingTask">Cancel</FluentButton>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="job-row job-task @(task.Status == JobTaskStatus.Done ? "job-task--done" : "")">
                                                    <FluentCheckbox Value="@(task.Status == JobTaskStatus.Done)"
                                                                    ValueChanged="@(v => ToggleTaskDoneAsync(task, v))"
                                                                    title="@(task.Status == JobTaskStatus.Done ? "Reopen" : "Mark done")" />
                                                    <div class="job-task-main">
                                                        <div>
                                                            <span class="job-task-code">@task.Code</span>
                                                            <span class="job-task-name">@task.Name</span>
                                                        </div>
                                                        <div class="job-task-sub">
                                                            @(task.AssignedEmployeeIds.Count == 0 ? "job assignees" : string.Join(", ", task.AssignedEmployeeIds.Select(id => employeeLookup.GetValueOrDefault(id, "?"))))
                                                            @if (!string.IsNullOrWhiteSpace(task.Description)) { <text> · @task.Description</text> }
                                                            @if (task.Status == JobTaskStatus.Done && task.DoneAt is DateTimeOffset doneAt) { <text> · done @doneAt.LocalDateTime.ToString("d MMM")</text> }
                                                        </div>
                                                    </div>
                                                    <span class="job-task-hours @(over ? "job-task-hours--over" : "")" title="@(over ? "Over the estimate" : "Logged / estimate")">
                                                        @logged.ToString("0.#") / @(task.EstimatedHours?.ToString("0.#") ?? "—") h
                                                    </span>
                                                    <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => BeginEditTask(task))">Edit</FluentButton>
                                                    <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => DeleteTaskAsync(task))" title="Delete task">✕</FluentButton>
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                                @if (addingTaskForJob == job.Id)
                                {
                                    <div class="job-task-edit">
                                        <div class="admin-grid">
                                            <div><FluentTextField Label="Task name *" @bind-Value="newTask.Name" Placeholder="e.g. Ný lýsing í móttöku" style="width:100%" /></div>
                                            <div><FluentNumberField TValue="decimal?" Label="Estimate (h)" @bind-Value="newTask.EstimatedHours" Min="0" Step="0.5" Placeholder="A day or two" style="width:100%" /></div>
                                            <div><EmployeeMultiSelect Label="Assigned (empty = job's)" Employees="employees" @bind-SelectedIds="newTaskEmployeeIds" /></div>
                                            <div><FluentTextField Label="Description" @bind-Value="newTask.Description" style="width:100%" /></div>
                                        </div>
                                        <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
                                            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" @onclick="@(() => AddTaskAsync(job))" Disabled="@(savingTask || string.IsNullOrWhiteSpace(newTask.Name))">@(savingTask ? "Adding…" : "Add task")</FluentButton>
                                            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" @onclick="@(() => addingTaskForJob = null)" Disabled="@savingTask">Cancel</FluentButton>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => BeginAddTask(job))">+ Add task</FluentButton>
                                }
                                @if (!string.IsNullOrWhiteSpace(taskError))
                                {
                                    <p class="job-empty-note" style="color:#b91c1c;">@taskError</p>
                                }
                            }
                            else
                            {
                                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => BeginAddTask(job))" title="Break this job into tasks">+ Add a task</FluentButton>
                            }

                            @* Workforce *@
                            <div class="job-section-title">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                                </svg>
                                Workforce
                            </div>

                            @if (details.ByEmployee.Count > 0)
                            {
                                <div class="job-rows">
                                    @foreach (var row in details.ByEmployee.OrderByDescending(r => r.Hours))
                                    {
                                        <div class="job-row">
                                            <span class="job-row-name">@row.EmployeeName</span>
                                            <span class="job-row-meta">
                                                <strong>@row.Hours.ToString("0.#") h</strong>
                                                @if (row.OvertimeHours > 0)
                                                {
                                                    <span class="job-row-ot"> + @row.OvertimeHours.ToString("0.#") OT</span>
                                                }
                                                @if (row.DrivingUnits > 0)
                                                {
                                                    <span class="job-row-dim"> · @row.DrivingUnits unit@(row.DrivingUnits == 1 ? "" : "s") driving</span>
                                                }
                                                <span class="job-row-dim"> · @row.EntryCount entr@(row.EntryCount == 1 ? "y" : "ies")</span>
                                                @if (row.LastDate.HasValue)
                                                {
                                                    <span class="job-row-dim"> · last @row.LastDate.Value.ToString("dd MMM yyyy")</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="job-empty-note">No hours logged on this job yet.</p>
                            }

                            @* Materials *@
                            <div class="job-section-title">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                    <path d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4z"/>
                                    <path fill-rule="evenodd" d="M3 8h14v7a2 2 0 01-2 2H5a2 2 0 01-2-2V8zm5 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                </svg>
                                Materials used
                            </div>

                            @if (details.ByMaterial.Count > 0)
                            {
                                <div class="job-rows">
                                    @foreach (var row in details.ByMaterial.OrderByDescending(r => r.TotalCostExVat))
                                    {
                                        <div class="job-row">
                                            <span class="job-row-name">@row.MaterialName</span>
                                            <span class="job-row-meta">
                                                <strong>@row.TotalQty.ToString("0.##") @row.Unit</strong>
                                                @if (row.TotalCostExVat > 0)
                                                {
                                                    <span class="job-row-dim"> · @row.TotalCostExVat.ToString("N0") kr. ex. VAT
                                                        (@row.TotalCostInclVat.ToString("N0") kr. incl.)</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="job-material-total">
                                    Total: <strong>@details.MaterialCostExVat.ToString("N0") kr.</strong> ex. VAT
                                    <span style="color:#9ca3af;font-weight:400;margin:0 0.2rem">·</span>
                                    <strong>@details.MaterialCostInclVat.ToString("N0") kr.</strong> incl. VAT
                                </div>
                            }
                            else
                            {
                                <p class="job-empty-note">No materials logged on this job yet.</p>
                            }

                            @* Edit inline *@
                            @if (isEditing && editingJob is not null)
                            {
                                <div class="job-edit-form">
                                    <div class="job-section-title">
                                        <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                                        </svg>
                                        Edit job
                                    </div>
                                    <div class="admin-grid" style="margin-top:0.5rem;">
                                        <div>
                                            <FluentSelect Label="Customer" TValue="string" TOption="string" @bind-Value="editingCustomerId" style="width:100%">
                                                @foreach (var c in customers)
                                                {
                                                    <FluentOption TOption="string" Value="@c.Id.ToString()">@c.Name</FluentOption>
                                                }
                                            </FluentSelect>
                                        </div>
                                        <div>
                                            <EmployeeMultiSelect Employees="employees" @bind-SelectedIds="editingEmployeeIds" />
                                        </div>
                                        <div>
                                            <FluentTextField Label="Job name" @bind-Value="editingJob.Name" style="width:100%" />
                                        </div>
                                        <div>
                                            <FluentTextField Label="Job code (auto-generated)" Value="@editingJob.Code" ReadOnly="true" style="width:100%; opacity:0.6;" />
                                        </div>
                                        <div>
                                            <FluentTextField Label="Category (fixed at creation)" Value="@CategoryLabel(editingJob.Category)" ReadOnly="true" style="width:100%; opacity:0.6;" />
                                        </div>
                                        <div>
                                            <FluentSelect Label="Billing type" TValue="string" TOption="string"
                                                          Value="@editingJob.BillingType.ToString()"
                                                          ValueChanged="@(v => editingJob.BillingType = Enum.TryParse<BillingType>(v, out var b) ? b : BillingType.Hourly)"
                                                          style="width:100%">
                                                <FluentOption TOption="string" Value="Hourly">Hourly</FluentOption>
                                                <FluentOption TOption="string" Value="FixedPrice">Fixed price</FluentOption>
                                            </FluentSelect>
                                        </div>
                                        <div style="display:flex; align-items:flex-end; gap:0.5rem;">
                                            <FluentButton Appearance="Appearance.Accent" @onclick="SaveJobAsync" Disabled="@(!HasEditingCustomer)">Save changes</FluentButton>
                                            <FluentButton Appearance="Appearance.Outline" @onclick="CancelJobEdit">Cancel</FluentButton>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="job-actions">
                                    @* Who made the job; blank for jobs that predate the audit columns. *@
                                    @if (job.CreatedAt is DateTimeOffset createdAt)
                                    {
                                        <span class="job-created">
                                            Created @createdAt.LocalDateTime.ToString("d MMM yyyy HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(job.CreatedByName)) { <text>by @job.CreatedByName</text> }
                                        </span>
                                    }
                                    <FluentButton Appearance="Appearance.Accent" @onclick="@(() => Nav.NavigateTo($"/jobs/{job.Id}"))">Details</FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" @onclick="@(() => BeginEditJob(job))">Edit job</FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" Class="job-delete-button" @onclick="@(() => BeginDeleteJob(job))">Delete job</FluentButton>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
}
else if (company is not null)
{
    <FluentCard Class="admin-card" AreaRestricted="false">
        <FluentLabel>No jobs yet. Add the first one above.</FluentLabel>
    </FluentCard>
}

@* ── Delete confirmation ── *@
@if (deletingJob is not null)
{
    <AppDialog Title="Delete job?" OnClose="CancelDeleteJob" Busy="deletingJobBusy">
        <p style="margin:0 0 0.75rem;">
            Delete <strong>@deletingJob.Code – @deletingJob.Name</strong>? Its tasks and files go with it, and this can't be undone.
        </p>
        <p class="job-delete-note">
            A job with hours, materials or billed expenses on it can't be deleted — move or delete those first.
        </p>
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <FluentLabel Color="Color.Error" style="display:block; margin-top:0.75rem;">@deleteError</FluentLabel>
        }
        <div class="job-delete-actions" style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1.25rem;">
            <FluentButton Appearance="Appearance.Outline" @onclick="CancelDeleteJob" Disabled="@deletingJobBusy">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Class="job-delete-button job-delete-button--confirm" @onclick="ConfirmDeleteJobAsync" Disabled="@deletingJobBusy">Delete job</FluentButton>
        </div>
    </AppDialog>
}


@code {
    // ── Lookup data ────────────────────────────────────────────────────────────
    private bool loading = true;
    private bool showCreateForm;
    private readonly List<Customer> customers = [];
    private readonly List<Job>      jobs      = [];
    private readonly List<Employee> employees = [];
    private readonly List<Material> materials = [];
    private readonly Dictionary<Guid, string>   customerLookup = new();
    private readonly Dictionary<Guid, string>   employeeLookup = new();
    private readonly Dictionary<Guid, Material> materialLookup = new();

    // ── Per-job detail cache ───────────────────────────────────────────────────
    private readonly Dictionary<Guid, JobDetail> jobDetails = new();

    // ── Tasks ──
    private readonly List<JobTask> tasks = [];
    private Guid? addingTaskForJob;
    private JobTask newTask = new();
    private List<Guid> newTaskEmployeeIds = [];
    private JobTask? editingTask;
    private List<Guid> editingTaskEmployeeIds = [];
    private bool savingTask;
    private string? taskError;
    /// <summary>Tasks typed into the create form when the customer plans jobs in tasks.</summary>
    private readonly List<NewTaskRow> newTasks = [new()];

    private sealed class NewTaskRow { public string Name { get; set; } = ""; public decimal? EstimatedHours { get; set; } }

    private List<JobTask> TasksFor(Guid jobId) => tasks.Where(t => t.JobId == jobId).ToList();
    private bool CustomerPlansTasks(Guid customerId) => customers.FirstOrDefault(c => c.Id == customerId)?.PlanJobsInTasks == true;
    private bool SelectedCustomerPlansTasks => Guid.TryParse(selectedCustomerId, out var cid) && CustomerPlansTasks(cid);

    private Company? company;
    private Guid?    expandedJobId;
    private Job?     editingJob;
    private Job?     deletingJob;
    private bool     deletingJobBusy;
    private string?  deleteError;
    private string?  editingCustomerId;
    private List<Guid> editingEmployeeIds = [];
    private string?     selectedCustomerId;
    private List<Guid> selectedEmployeeIds = [];
    private string      newJobName     = string.Empty;
    private BillingType newBillingType = BillingType.Hourly;
    private JobCategory newCategory    = JobCategory.NewInstallation;
    private string?  loadError;

    private bool HasSelectedCustomer => Guid.TryParse(selectedCustomerId, out _);
    private bool HasEditingCustomer  => Guid.TryParse(editingCustomerId,  out _);

    /// <summary>
    /// One pill, not one per person, so a busy job does not push the badges off
    /// the row. The header shows the first two names and a count for the rest;
    /// the full list goes in the tooltip.
    /// </summary>
    private string AssigneeNames(Job job, bool all)
    {
        var names = job.AssignedEmployeeIds
            .Select(id => employeeLookup.GetValueOrDefault(id, "—"))
            .ToList();
        if (all || names.Count <= 2)
            return string.Join(", ", names);
        return $"{names[0]}, {names[1]} +{names.Count - 2}";
    }

    private static string CategoryLabel(JobCategory cat) => cat switch
    {
        JobCategory.NewInstallation => "New Installation",
        JobCategory.Repair          => "Repair",
        JobCategory.InnerWork       => "Inner Work",
        JobCategory.Drawings        => "Drawings",
        JobCategory.Offer           => "Offer",
        JobCategory.Maintenance     => "Maintenance",
        JobCategory.Inspection      => "Inspection",
        JobCategory.Consultation    => "Consultation",
        _                           => cat.ToString()
    };

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
    }

    // ── Company settings state ──────────────────────────────────────────────────
    private decimal drivingUnitPrice;
    private decimal standardHoursPerDay = 8m;
    private bool    savingSettings;
    private string? settingsError;

    // ── View models ────────────────────────────────────────────────────────────
    private sealed class JobDetail
    {
        public decimal TotalHours           { get; set; }
        public decimal TotalOvertimeHours   { get; set; }
        public decimal MaterialCostExVat    { get; set; }
        public decimal MaterialCostInclVat  { get; set; }
        public int     WorkerCount          { get; set; }
        public int     EntryCount           { get; set; }
        public int     TotalDrivingUnits    { get; set; }
        public int     InvoicedEntryCount   { get; set; }
        public int     InvoicedMaterialUsageCount { get; set; }
        public List<int> InvoiceNumbers     { get; set; } = [];
        public List<EmployeeRow>   ByEmployee    { get; set; } = [];
        public List<MaterialRow>   ByMaterial    { get; set; } = [];
        /// <summary>Regular hours logged per task; entries without a task are not in here.</summary>
        public Dictionary<Guid, decimal> HoursByTask { get; set; } = new();

        public string InvoiceStatusLabel
        {
            get
            {
                if (InvoicedEntryCount == 0 && InvoicedMaterialUsageCount == 0)
                    return "";
                if (InvoicedEntryCount == EntryCount)
                    return "Fully invoiced";
                return "Partially invoiced";
            }
        }
    }

    private sealed class EmployeeRow
    {
        public string    EmployeeName  { get; set; } = string.Empty;
        public decimal   Hours         { get; set; }
        public decimal   OvertimeHours { get; set; }
        public int       DrivingUnits  { get; set; }
        public int       EntryCount    { get; set; }
        public DateOnly? LastDate      { get; set; }
    }

    private sealed class MaterialRow
    {
        public string  MaterialName      { get; set; } = string.Empty;
        public string  Unit              { get; set; } = string.Empty;
        public decimal TotalQty          { get; set; }
        public decimal TotalCostExVat    { get; set; }
        public decimal TotalCostInclVat  { get; set; }
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        customers.Clear(); jobs.Clear(); employees.Clear(); materials.Clear();
        customerLookup.Clear(); employeeLookup.Clear(); materialLookup.Clear();
        jobDetails.Clear(); expandedJobId = null; editingJob = null;

        var companyResult = await CompanyApi.GetCompanyAsync();
        company = companyResult.Value;
        if (!companyResult.IsSuccess || company is null) { loadError = companyResult.ErrorMessage; loading = false; return; }
        drivingUnitPrice = company.DrivingUnitPrice;
        standardHoursPerDay = company.StandardHoursPerDay;

        var custTask = CustomersApi.GetCustomersAsync();
        var jobTask  = JobsApi.GetJobsAsync();
        var empTask  = EmployeesApi.GetEmployeesAsync();
        var matTask  = MaterialsApi.GetMaterialsAsync();
        var tasksTask = JobTasksApi.GetTasksAsync();
        await Task.WhenAll(custTask, jobTask, empTask, matTask, tasksTask);

        tasks.Clear();
        tasks.AddRange((await tasksTask).Value ?? []);

        var custR = await custTask;
        var jobR  = await jobTask;
        var empR  = await empTask;
        var matR  = await matTask;

        if (!custR.IsSuccess) { loadError = custR.ErrorMessage; loading = false; return; }
        if (!jobR.IsSuccess)  { loadError = jobR.ErrorMessage;  loading = false; return; }

        customers.AddRange(custR.Value ?? []);
        selectedCustomerId = customers.FirstOrDefault()?.Id.ToString();
        foreach (var c in customers) customerLookup[c.Id] = c.Name;

        // Newest first. The API orders by code, which groups by category now
        // that the code is category + number; the running number says which
        // job came last. Same order as the employee apps.
        jobs.AddRange((jobR.Value ?? []).OrderByDescending(j => j.JobNumber).ThenByDescending(j => j.Code));

        employees.AddRange(empR.Value ?? []);
        foreach (var e in employees) employeeLookup[e.Id] = e.DisplayName;

        materials.AddRange(matR.Value ?? []);
        foreach (var m in materials) materialLookup[m.Id] = m;
        loading = false;
    }

    // ── Accordion ──────────────────────────────────────────────────────────────
    private async Task ToggleJobAsync(Job job)
    {
        if (expandedJobId == job.Id)
        {
            expandedJobId = null;
            editingJob    = null;
            return;
        }

        expandedJobId = job.Id;
        editingJob    = null;

        if (!jobDetails.ContainsKey(job.Id))
            await LoadJobDetailAsync(job.Id);
    }

    private async Task LoadJobDetailAsync(Guid jobId)
    {
        var entriesTask = TimeEntriesApi.GetTimeEntriesAsync(jobId: jobId);
        var usageTask   = MaterialsApi.GetMaterialUsageAsync(jobId: jobId);
        await Task.WhenAll(entriesTask, usageTask);

        var entries = (await entriesTask).Value ?? [];
        var usages  = (await usageTask).Value   ?? [];

        var byEmp = entries
            .GroupBy(e => e.EmployeeId)
            .Select(g => new EmployeeRow
            {
                EmployeeName  = employeeLookup.GetValueOrDefault(g.Key, g.Key.ToString()[..8]),
                Hours         = g.Sum(e => e.Hours),
                OvertimeHours = g.Sum(e => e.OvertimeHours),
                DrivingUnits  = g.Sum(e => e.DrivingUnits),
                EntryCount    = g.Count(),
                LastDate      = g.Max(e => e.WorkDate)
            })
            .ToList();

        var byMat = usages
            .GroupBy(u => u.MaterialId)
            .Select(g =>
            {
                var mat      = materialLookup.GetValueOrDefault(g.Key);
                var qty      = g.Sum(u => u.Quantity);
                var costEx   = mat is not null ? qty * mat.UnitPrice : 0m;
                var costIncl = mat is not null ? costEx * (1 + mat.VatRate / 100m) : 0m;
                return new MaterialRow
                {
                    MaterialName     = mat?.Name ?? g.Key.ToString()[..8],
                    Unit             = mat?.Unit ?? string.Empty,
                    TotalQty         = qty,
                    TotalCostExVat   = costEx,
                    TotalCostInclVat = costIncl
                };
            })
            .ToList();

        var invoicedEntries = entries.Where(e => e.IsInvoiced).ToList();
        var invoicedUsages = usages.Where(u => u.IsInvoiced).ToList();
        var invoiceNumbers = invoicedEntries
            .Where(e => e.PaydayInvoiceNumber.HasValue)
            .Select(e => e.PaydayInvoiceNumber!.Value)
            .Union(invoicedUsages
                .Where(u => u.PaydayInvoiceNumber.HasValue)
                .Select(u => u.PaydayInvoiceNumber!.Value))
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        jobDetails[jobId] = new JobDetail
        {
            TotalHours           = entries.Sum(e => e.Hours),
            TotalOvertimeHours   = entries.Sum(e => e.OvertimeHours),
            WorkerCount          = byEmp.Count,
            EntryCount           = entries.Count,
            MaterialCostExVat    = byMat.Sum(m => m.TotalCostExVat),
            MaterialCostInclVat  = byMat.Sum(m => m.TotalCostInclVat),
            TotalDrivingUnits    = byEmp.Sum(r => r.DrivingUnits),
            InvoicedEntryCount   = invoicedEntries.Count,
            InvoicedMaterialUsageCount = invoicedUsages.Count,
            InvoiceNumbers       = invoiceNumbers,
            ByEmployee           = byEmp,
            ByMaterial           = byMat,
            HoursByTask          = entries.Where(e => e.TaskId != null)
                                          .GroupBy(e => e.TaskId!.Value)
                                          .ToDictionary(g => g.Key, g => g.Sum(e => e.Hours))
        };
    }

    // ── CRUD ───────────────────────────────────────────────────────────────────
    private async Task CreateJobAsync()
    {
        if (company is null || !Guid.TryParse(selectedCustomerId, out var customerId) || string.IsNullOrWhiteSpace(newJobName))
            return;

        var result = await JobsApi.CreateJobAsync(new Job
        {
            CompanyId          = company.Id,
            CustomerId         = customerId,
            AssignedEmployeeIds = [.. selectedEmployeeIds],
            Name               = newJobName.Trim(),
            BillingType        = newBillingType,
            Category           = newCategory
        });

        if (result.IsSuccess && result.Value is Job created)
        {
            // First tasks, typed while creating the job. Server assigns numbers and codes.
            foreach (var row in newTasks.Where(r => !string.IsNullOrWhiteSpace(r.Name)))
            {
                var tr = await JobTasksApi.CreateTaskAsync(created.Id, new JobTask { Name = row.Name.Trim(), EstimatedHours = row.EstimatedHours });
                if (!tr.IsSuccess) { loadError = tr.ErrorMessage; break; }
            }
            newTasks.Clear(); newTasks.Add(new NewTaskRow());
        }
        if (result.IsSuccess) { newJobName = string.Empty; newBillingType = BillingType.Hourly; newCategory = JobCategory.NewInstallation; selectedEmployeeIds = []; showCreateForm = false; await LoadAsync(); }
        else { loadError = result.ErrorMessage; }
    }

    // ── Tasks ────────────────────────────────────────────────────────────────

    private void BeginAddTask(Job job)
    {
        addingTaskForJob   = job.Id;
        newTask            = new JobTask();
        newTaskEmployeeIds = [];
        editingTask        = null;
        taskError          = null;
    }

    private async Task AddTaskAsync(Job job)
    {
        if (string.IsNullOrWhiteSpace(newTask.Name)) return;
        savingTask = true; taskError = null;
        try
        {
            newTask.AssignedEmployeeIds = [.. newTaskEmployeeIds];
            var result = await JobTasksApi.CreateTaskAsync(job.Id, newTask);
            if (result.IsSuccess && result.Value is not null)
            {
                tasks.Add(result.Value);
                newTask = new JobTask(); newTaskEmployeeIds = [];
                addingTaskForJob = null;
            }
            else taskError = result.ErrorMessage;
        }
        finally { savingTask = false; }
    }

    private void BeginEditTask(JobTask task)
    {
        editingTask = new JobTask
        {
            Id = task.Id, CompanyId = task.CompanyId, JobId = task.JobId, TaskNumber = task.TaskNumber, Code = task.Code,
            Name = task.Name, Description = task.Description, Status = task.Status, EstimatedHours = task.EstimatedHours,
            AssignedEmployeeIds = [.. task.AssignedEmployeeIds], SortOrder = task.SortOrder,
        };
        editingTaskEmployeeIds = [.. task.AssignedEmployeeIds];
        addingTaskForJob = null;
        taskError = null;
    }

    private async Task SaveTaskAsync()
    {
        if (editingTask is null) return;
        savingTask = true; taskError = null;
        try
        {
            editingTask.AssignedEmployeeIds = [.. editingTaskEmployeeIds];
            var result = await JobTasksApi.UpdateTaskAsync(editingTask);
            if (result.IsSuccess && result.Value is not null)
            {
                ReplaceTask(result.Value);
                editingTask = null;
            }
            else taskError = result.ErrorMessage;
        }
        finally { savingTask = false; }
    }

    private async Task ToggleTaskDoneAsync(JobTask task, bool done)
    {
        taskError = null;
        var result = done ? await JobTasksApi.MarkDoneAsync(task.Id) : await JobTasksApi.ReopenAsync(task.Id);
        if (result.IsSuccess && result.Value is not null) ReplaceTask(result.Value);
        else taskError = result.ErrorMessage;
    }

    private async Task DeleteTaskAsync(JobTask task)
    {
        taskError = null;
        var result = await JobTasksApi.DeleteTaskAsync(task.Id);
        if (result.IsSuccess)
        {
            tasks.RemoveAll(t => t.Id == task.Id);
            // Its hours stay on the job; the per-task split just no longer names it.
            if (jobDetails.ContainsKey(task.JobId)) await LoadJobDetailAsync(task.JobId);
        }
        else taskError = result.ErrorMessage;
    }

    private void ReplaceTask(JobTask updated)
    {
        var i = tasks.FindIndex(t => t.Id == updated.Id);
        if (i >= 0) tasks[i] = updated; else tasks.Add(updated);
    }

    private void BeginEditJob(Job job)
    {
        editingJob = new Job { Id = job.Id, CompanyId = job.CompanyId, CustomerId = job.CustomerId, AssignedEmployeeIds = [.. job.AssignedEmployeeIds], Code = job.Code, Name = job.Name, BillingType = job.BillingType };
        editingCustomerId = job.CustomerId.ToString();
        editingEmployeeIds = [.. job.AssignedEmployeeIds];
    }

    private async Task SaveJobAsync()
    {
        if (editingJob is null || !Guid.TryParse(editingCustomerId, out var customerId)) return;
        editingJob.CustomerId         = customerId;
        editingJob.AssignedEmployeeIds = [.. editingEmployeeIds];
        var result = await JobsApi.UpdateJobAsync(editingJob);
        if (result.IsSuccess) { editingJob = null; editingCustomerId = null; editingEmployeeIds = []; await LoadAsync(); }
        else { loadError = result.ErrorMessage; }
    }

    private void CancelJobEdit() { editingJob = null; editingCustomerId = null; editingEmployeeIds = []; }

    // ── Delete ─────────────────────────────────────────────────────────────────
    private void BeginDeleteJob(Job job) { deletingJob = job; deleteError = null; }

    private void CancelDeleteJob() { if (!deletingJobBusy) { deletingJob = null; deleteError = null; } }

    /// <summary>
    /// The API refuses (409) while the job has hours, materials or billed
    /// expenses on it and says why; that reason is shown in the dialog so the
    /// owner knows what to clear first.
    /// </summary>
    private async Task ConfirmDeleteJobAsync()
    {
        if (deletingJob is null) return;
        deletingJobBusy = true; deleteError = null;
        try
        {
            using var busy = Busy.Begin("Deleting job…");
            var result = await JobsApi.DeleteJobAsync(deletingJob.Id);
            if (result.IsSuccess)
            {
                deletingJob = null;
                await LoadAsync();
            }
            else deleteError = result.ErrorMessage;
        }
        finally { deletingJobBusy = false; }
    }

    // ── Company settings ──────────────────────────────────────────────────────
    private async Task SaveCompanySettingsAsync()
    {
        savingSettings = true;
        settingsError  = null;
        try
        {
            var rateResult  = await CompanyApi.UpdateDrivingRateAsync(drivingUnitPrice);
            var hoursResult = await CompanyApi.UpdateStandardHoursAsync(standardHoursPerDay);

            if (!rateResult.IsSuccess)
                settingsError = rateResult.ErrorMessage;
            else if (!hoursResult.IsSuccess)
                settingsError = hoursResult.ErrorMessage;
            else if (company is not null)
            {
                company.DrivingUnitPrice = drivingUnitPrice;
                company.StandardHoursPerDay = standardHoursPerDay;
            }
        }
        finally { savingSettings = false; }
    }
}
