@page "/payday/products"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IPaydayProductsCacheApi ProductsApi
@inject BusyService Busy
@inject NavigationManager Navigation
@using Workit.Shared.Payday

<PageTitle>Payday Products</PageTitle>

<FluentCard Class="admin-card" AreaRestricted="false">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <div>
            <FluentLabel Typo="Typography.PaneHeader">Payday Products</FluentLabel>
            <FluentLabel Style="color:#60758b; margin-top:0.25rem;">
                Your Payday product list is Workit's price list. Prices, VAT and ledger accounts come from Payday;
                here you say what each product is <em>for</em>.
            </FluentLabel>
        </div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
            @if (lastSynced is not null)
            {
                <FluentLabel Style="color:#60758b; font-size:0.85rem;">Synced @lastSynced.Value.LocalDateTime.ToString("d MMM HH:mm")</FluentLabel>
            }
            <FluentButton Appearance="Appearance.Accent" @onclick="OpenCreateAsync" Disabled="@loading">+ New product</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="SyncAsync" Disabled="@loading">Sync now</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => Navigation.NavigateTo("/payday"))">← Back to Payday</FluentButton>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <FluentLabel Color="@(messageIsError ? Color.Error : Color.Success)" style="margin-top:0.75rem; display:block;">@message</FluentLabel>
    }
</FluentCard>

@* ── New product ── *@
@if (showCreate)
{
    <AppDialog Title="New product" OnClose="CloseCreate" Busy="creating">
        <FluentLabel Style="color:#60758b; font-size:0.9rem;">
            Created in Payday — your price list lives there — and ready to use in Workit straight away.
        </FluentLabel>
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div><FluentTextField Label="Name *" @bind-Value="newName" Placeholder="e.g. Vinna rafvirkja" style="width:100%" /></div>
            <div><FluentTextField Label="SKU *" @bind-Value="newSku" Placeholder="e.g. VINNA" style="width:100%" /></div>
            <div>
                <FluentNumberField Label="Sale price (ex. VAT) *" TValue="decimal" @bind-Value="newPrice" Min="0" Step="1" style="width:100%" />
            </div>
            <div>
                <FluentSelect TValue="string" TOption="string" Label="VAT %" Value="@newVat.ToString("0.##")" ValueChanged="OnVatChanged" style="width:100%">
                    <FluentOption TOption="string" Value="24">24 %</FluentOption>
                    <FluentOption TOption="string" Value="11">11 %</FluentOption>
                    <FluentOption TOption="string" Value="0">0 % (VAT-free)</FluentOption>
                </FluentSelect>
            </div>
            <div>
                <FluentSelect TValue="string" TOption="string" Label="Sales account in Payday *" @bind-Value="newLedgerId" style="width:100%">
                    @foreach (var a in ledgerAccounts)
                    {
                        <FluentOption TOption="string" Value="@a.Id.ToString()">@a.Code @a.Name</FluentOption>
                    }
                </FluentSelect>
            </div>
            <div>
                <FluentSelect TValue="string" TOption="string" Label="Used in Workit as" @bind-Value="newRole" style="width:100%">
                    @foreach (var r in Enum.GetValues<PaydayProductRole>())
                    {
                        <FluentOption TOption="string" Value="@r.ToString()">@RoleLabel(r)</FluentOption>
                    }
                </FluentSelect>
            </div>
            <div><FluentTextField Label="Unit" @bind-Value="newUnit" Placeholder="klst. / stk. / m" style="width:100%" /></div>
            <div><FluentTextField Label="Category" @bind-Value="newCategory" Placeholder="Optional" style="width:100%" /></div>
            <div style="grid-column:1 / -1;"><FluentTextField Label="Description" @bind-Value="newDescription" Placeholder="Optional" style="width:100%" /></div>
            <div style="grid-column:1 / -1;">
                <FluentSwitch @bind-Value="newTrackStock" Label="Track stock in Payday" />
                <div style="color:#60758b; font-size:0.85rem; margin-top:0.2rem;">On for goods you keep in stock; off for labor, driving and other service lines.</div>
            </div>
            @if (newTrackStock)
            {
                <div><FluentNumberField Label="Opening stock" TValue="decimal" @bind-Value="newOpeningQty" Min="0" Step="1" style="width:100%" /></div>
                <div><FluentNumberField Label="Purchase price (ex. VAT)" TValue="decimal" @bind-Value="newPurchasePrice" Min="0" Step="1" style="width:100%" /></div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(createError))
        {
            <FluentLabel Color="Color.Error" role="alert" style="margin-top:0.5rem; display:block;">@createError</FluentLabel>
        }
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="CreateAsync" Disabled="@(creating || !CanCreate)">Create in Payday</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="CloseCreate" Disabled="@creating">Cancel</FluentButton>
        </div>
    </AppDialog>
}

@if (!loading && TotalLive > 0 && MissingLaborRoles.Count > 0)
{
    <FluentCard Class="admin-card" AreaRestricted="false" Style="border-left:4px solid #b45309;">
        <FluentLabel Style="font-weight:600; color:#b45309;">Invoices can't be built by product yet</FluentLabel>
        <FluentLabel Style="color:#60758b; font-size:0.9rem; margin-top:0.25rem;">
            Pick which Payday product is your
            @for (var i = 0; i < MissingLaborRoles.Count; i++)
            {
                if (i > 0) { <text>, </text> }
                <strong>@RoleLabel(MissingLaborRoles[i])</strong>
            }.
            If Payday has no such product yet, press <strong>+ New product</strong> — it is created in Payday and given the role in one step.
        </FluentLabel>
    </FluentCard>
}

<FluentCard Class="admin-card" AreaRestricted="false">
    <div class="filters">
        <FluentTextField Placeholder="Search SKU, name or category…" Value="@search" ValueChanged="OnSearchChanged" Immediate="true" ImmediateDelay="300" style="width:280px;" />
        <div class="chips">
            <button class="chip @(roleFilter is null ? "chip--on" : "")" @onclick="@(() => SetRoleFilterAsync(null))">All <span class="chip-n">@TotalLive</span></button>
            @foreach (var r in ChipRoles)
            {
                var n = listPage?.RoleCounts.GetValueOrDefault(r) ?? 0;
                <button class="chip @(roleFilter == r ? "chip--on" : "") @(r == PaydayProductRole.Unassigned && n > 0 ? "chip--attention" : "")"
                        @onclick="@(() => SetRoleFilterAsync(r))">
                    @(r == PaydayProductRole.Unassigned ? "Needs a role" : RoleLabel(r)) <span class="chip-n">@n</span>
                </button>
            }
        </div>
        <FluentCheckbox Value="@showArchived" ValueChanged="OnShowArchivedChanged" Label="Show archived" />
    </div>

    @if (loading && listPage is null)
    {
        <PageLoader />
    }
    else if (listPage is { Total: 0 } && string.IsNullOrWhiteSpace(search) && roleFilter is null)
    {
        <FluentLabel Style="color:#60758b;">
            No products yet. Press <strong>Sync now</strong> to pull the list from Payday.
        </FluentLabel>
    }
    else if (listPage is not null)
    {
        <div class="table-wrap @(loading ? "table-wrap--loading" : "")">
            <table class="products">
                <thead>
                    <tr>
                        <th><button class="sort" @onclick="@(() => SortByAsync("sku"))">SKU @SortMark("sku")</button></th>
                        <th><button class="sort" @onclick="@(() => SortByAsync("name"))">Name @SortMark("name")</button></th>
                        <th class="num"><button class="sort" @onclick="@(() => SortByAsync("price"))">Sale (ex. VAT) @SortMark("price")</button></th>
                        <th class="num">VAT %</th>
                        <th class="num"><button class="sort" @onclick="@(() => SortByAsync("stock"))">Stock in Payday @SortMark("stock")</button></th>
                        <th>Used in Workit as</th>
                        <th>Unit</th>
                        <th>Category</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (listPage.Items.Count == 0)
                    {
                        <tr><td colspan="9" class="empty">Nothing matches@(string.IsNullOrWhiteSpace(search) ? "" : $" “{search}”")@(roleFilter is null ? "" : $" under {RoleLabel(roleFilter.Value)}").</td></tr>
                    }
                    @foreach (var p in listPage.Items)
                    {
                        <tr class="@(p.Archived ? "row--archived" : "")" @onclick="@(() => BeginEdit(p))">
                            <td class="sku">@p.Sku</td>
                            <td>
                                <span class="name">@p.Name</span>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="desc">@p.Description</div>
                                }
                            </td>
                            <td class="num">@p.SalePriceExVat.ToString("N0") kr.</td>
                            <td class="num">@p.VatPercentage.ToString("0.#")</td>
                            <td class="num">
                                @if (p.Quantity is decimal q)
                                {
                                    <span class="@(q <= 0 ? "stock--out" : "")">@q.ToString("0.##") @p.Unit</span>
                                }
                                else
                                {
                                    <span class="muted">not tracked</span>
                                }
                            </td>
                            <td>
                                <span class="role role--@p.Role.ToString().ToLowerInvariant()">@RoleLabel(p.Role)</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Category) ? "—" : p.Category)</td>
                            <td class="actions">
                                @if (p.Archived)
                                {
                                    <span class="archived">Archived</span>
                                }
                                <span @onclick:stopPropagation="true"><FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => BeginEdit(p))">Edit</FluentButton></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pager">
            <span class="pager-info">
                @if (listPage.Total == 0) { <text>0 products</text> }
                else { <text>@(((listPage.Page - 1) * listPage.PageSize) + 1)–@Math.Min(listPage.Page * listPage.PageSize, listPage.Total) of @listPage.Total</text> }
            </span>
            <div class="pager-buttons">
                <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Disabled="@(listPage.Page <= 1 || loading)" @onclick="@(() => GoToPageAsync(listPage.Page - 1))">‹ Previous</FluentButton>
                <span class="pager-listPage">Page @listPage.Page of @Math.Max(1, PageCount)</span>
                <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Disabled="@(listPage.Page >= PageCount || loading)" @onclick="@(() => GoToPageAsync(listPage.Page + 1))">Next ›</FluentButton>
            </div>
            <FluentSelect TValue="string" TOption="string" Value="@pageSize.ToString()" ValueChanged="OnPageSizeChanged" style="width:110px;">
                <FluentOption TOption="string" Value="25">25 / listPage</FluentOption>
                <FluentOption TOption="string" Value="50">50 / listPage</FluentOption>
                <FluentOption TOption="string" Value="100">100 / listPage</FluentOption>
            </FluentSelect>
        </div>
    }
</FluentCard>

@* ── Edit one product's Workit fields ── *@
@if (editing is not null)
{
    <AppDialog Title="@($"{editing.Sku} — {editing.Name}")" OnClose="CancelEdit" Busy="saving">
        <FluentLabel Style="color:#60758b; font-size:0.9rem;">
            @editing.SalePriceExVat.ToString("N0") kr. ex. VAT · @editing.VatPercentage.ToString("0.#") % ·
            @(editing.Quantity is decimal eq ? $"{eq:0.##} in stock" : "not stock-tracked") — prices and stock are Payday's; these three fields are Workit's.
        </FluentLabel>
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div>
                <FluentSelect TValue="string" TOption="string" Label="Used in Workit as" @bind-Value="editRole" style="width:100%">
                    @foreach (var r in Enum.GetValues<PaydayProductRole>())
                    {
                        <FluentOption TOption="string" Value="@r.ToString()">@RoleLabel(r)</FluentOption>
                    }
                </FluentSelect>
            </div>
            <div><FluentTextField Label="Unit" @bind-Value="editUnit" Placeholder="stk. / klst. / m" style="width:100%" /></div>
            <div><FluentTextField Label="Category" @bind-Value="editCategory" Placeholder="Optional — groups the app's material picker" style="width:100%" /></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(editError))
        {
            <FluentLabel Color="Color.Error" role="alert" style="margin-top:0.5rem; display:block;">@editError</FluentLabel>
        }
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="SaveEditAsync" Disabled="@saving">Save</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit" Disabled="@saving">Cancel</FluentButton>
        </div>
    </AppDialog>
}

@code {
    /// <summary>List state lives in the URL so back/forward and "browse away and back" land on the same listPage.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "q")]    public string? QueryQ { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "role")] public string? QueryRole { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public int? QueryPage { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "size")] public int? QuerySize { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "archived")] public bool? QueryArchived { get; set; }

    private PaydayProductPage? listPage;
    private bool loading = true;
    private bool showArchived;
    private string search = string.Empty;
    private PaydayProductRole? roleFilter;
    private string sort = "sku";
    private bool sortDesc;
    private int pageNumber = 1;
    private int pageSize = 50;
    private string? message;
    private bool messageIsError;
    private DateTimeOffset? lastSynced;
    private int loadVersion;

    private static readonly PaydayProductRole[] LaborRoles = [PaydayProductRole.RegularHour, PaydayProductRole.OvertimeHour, PaydayProductRole.DrivingUnit];
    private static readonly PaydayProductRole[] ChipRoles = [PaydayProductRole.Unassigned, PaydayProductRole.Material, PaydayProductRole.RegularHour, PaydayProductRole.OvertimeHour, PaydayProductRole.DrivingUnit, PaydayProductRole.Ignore];

    private int TotalLive => listPage?.RoleCounts.Values.Sum() ?? 0;
    private int PageCount => listPage is null ? 1 : (int)Math.Ceiling(listPage.Total / (double)listPage.PageSize);

    /// <summary>Labor roles no live product carries yet — invoices need all three.</summary>
    private List<PaydayProductRole> MissingLaborRoles =>
        listPage is null ? [] : LaborRoles.Where(r => listPage.RoleCounts.GetValueOrDefault(r) == 0).ToList();

    internal static string RoleLabel(PaydayProductRole role) => role switch
    {
        PaydayProductRole.Unassigned   => "— Not set —",
        PaydayProductRole.Material     => "Material",
        PaydayProductRole.RegularHour  => "Regular hour",
        PaydayProductRole.OvertimeHour => "Overtime hour",
        PaydayProductRole.DrivingUnit  => "Driving unit",
        PaydayProductRole.Ignore       => "Not used in Workit",
        _ => role.ToString(),
    };

    private string SortMark(string column) => sort == column ? (sortDesc ? "↓" : "↑") : "";

    protected override void OnParametersSet()
    {
        search = QueryQ ?? string.Empty;
        roleFilter = Enum.TryParse<PaydayProductRole>(QueryRole, out var r) ? r : null;
        pageNumber = Math.Max(1, QueryPage ?? 1);
        pageSize = QuerySize is 25 or 50 or 100 ? QuerySize.Value : 50;
        showArchived = QueryArchived ?? false;
        var s = QuerySort ?? "sku";
        sortDesc = s.EndsWith("-desc", StringComparison.Ordinal);
        sort = sortDesc ? s[..^5] : s;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        loading = true; StateHasChanged();
        var result = await ProductsApi.GetPageAsync(search, roleFilter, showArchived, sort, sortDesc, pageNumber, pageSize);
        if (version != loadVersion) return; // a newer request superseded this one
        if (result.IsSuccess && result.Value is { } p)
        {
            listPage = p;
            lastSynced = p.LastSyncedAt;
            // Past the last listPage (a filter shrank the list): snap back.
            if (p.Total > 0 && p.Items.Count == 0 && pageNumber > 1)
            {
                pageNumber = Math.Max(1, (int)Math.Ceiling(p.Total / (double)p.PageSize));
                PushUrl();
                await LoadAsync();
                return;
            }
        }
        else
        {
            message = result.ErrorMessage; messageIsError = true;
        }
        loading = false; StateHasChanged();
    }

    /// <summary>Writes the list state to the URL without a navigation round-trip.</summary>
    private void PushUrl()
    {
        var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"]        = string.IsNullOrWhiteSpace(search) ? null : search,
            ["role"]     = roleFilter?.ToString(),
            ["page"]     = pageNumber > 1 ? pageNumber : null,
            ["size"]     = pageSize != 50 ? pageSize : null,
            ["sort"]     = sort == "sku" && !sortDesc ? null : sort + (sortDesc ? "-desc" : ""),
            ["archived"] = showArchived ? true : null,
        });
        Navigation.NavigateTo(url, replace: true);
    }

    private async Task OnSearchChanged(string? value)
    {
        search = value ?? string.Empty;
        pageNumber = 1;
        PushUrl();
        await LoadAsync();
    }

    private async Task SetRoleFilterAsync(PaydayProductRole? role)
    {
        roleFilter = roleFilter == role ? null : role;
        pageNumber = 1;
        PushUrl();
        await LoadAsync();
    }

    private async Task OnShowArchivedChanged(bool value)
    {
        showArchived = value; pageNumber = 1;
        PushUrl();
        await LoadAsync();
    }

    private async Task SortByAsync(string column)
    {
        if (sort == column) sortDesc = !sortDesc; else { sort = column; sortDesc = false; }
        pageNumber = 1;
        PushUrl();
        await LoadAsync();
    }

    private async Task GoToPageAsync(int number)
    {
        pageNumber = Math.Clamp(number, 1, Math.Max(1, PageCount));
        PushUrl();
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(string? value)
    {
        if (!int.TryParse(value, out var size) || size == pageSize) return;
        pageSize = size; pageNumber = 1;
        PushUrl();
        await LoadAsync();
    }

    private async Task SyncAsync()
    {
        message = null;
        using var busy = Busy.Begin("Syncing products from Payday…");
        var result = await ProductsApi.SyncAsync();
        if (result.IsSuccess && result.Value is { } r)
        {
            message = $"✓ {r.Fetched} products from Payday — {r.Added} new, {r.Updated} updated, {r.Archived} archived.";
            messageIsError = false;
            await LoadAsync();
        }
        else
        {
            // Payday's own reason, verbatim — "Client authentication failed…" tells the owner what to fix.
            message = result.ErrorMessage ?? "Payday products could not be synced right now.";
            messageIsError = true;
        }
    }

    // ── Edit one row ──
    private PaydayProductCache? editing;
    private string editRole = "", editUnit = "", editCategory = "";
    private string? editError;
    private bool saving;

    private void BeginEdit(PaydayProductCache p)
    {
        editing = p;
        editRole = p.Role.ToString(); editUnit = p.Unit; editCategory = p.Category;
        editError = null;
    }

    private void CancelEdit() { if (!saving) editing = null; }

    private async Task SaveEditAsync()
    {
        if (editing is null || saving) return;
        saving = true; editError = null;
        try
        {
            var role = Enum.TryParse<PaydayProductRole>(editRole, out var r) ? r : editing.Role;
            var result = await ProductsApi.SetRoleAsync(editing.Id, role, editUnit.Trim(), editCategory.Trim());
            if (result.IsSuccess && result.Value is { } saved)
            {
                editing.Role = saved.Role; editing.Unit = saved.Unit; editing.Category = saved.Category;
                editing = null;
                // Chip counts and the labor warning depend on roles; refresh quietly.
                await LoadAsync();
            }
            else
            {
                editError = result.ErrorMessage ?? "The product could not be saved right now.";
            }
        }
        finally
        {
            saving = false;
        }
    }

    // ── New product ──
    private bool showCreate, creating;
    private string? createError;
    private List<PaydayLedgerAccount> ledgerAccounts = [];
    private string newName = "", newSku = "", newDescription = "", newUnit = "", newCategory = "";
    private decimal newPrice, newVat = 24, newOpeningQty, newPurchasePrice;
    private string newLedgerId = "";
    private string newRole = PaydayProductRole.Unassigned.ToString();
    private bool newTrackStock;

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(newName) && !string.IsNullOrWhiteSpace(newSku) && Guid.TryParse(newLedgerId, out _);

    private async Task OpenCreateAsync()
    {
        createError = null;
        newName = newSku = newDescription = newCategory = ""; newUnit = "klst.";
        newPrice = 0; newVat = 24; newOpeningQty = 0; newPurchasePrice = 0; newTrackStock = false;
        newRole = PaydayProductRole.Unassigned.ToString();
        showCreate = true;

        if (ledgerAccounts.Count == 0)
        {
            var result = await ProductsApi.GetSalesLedgerAccountsAsync();
            if (result.IsSuccess) ledgerAccounts = result.Value ?? [];
            else createError = result.ErrorMessage;
        }
        PickLedgerForVat();
    }

    private void CloseCreate() { if (!creating) showCreate = false; }

    private void OnVatChanged(string? value)
    {
        if (decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) newVat = v;
        PickLedgerForVat();
    }

    /// <summary>Payday does not check a line's VAT against its account, so we steer the owner to the matching one.</summary>
    private void PickLedgerForVat()
    {
        var wanted = newVat switch { 24 => "StandardVAT", 11 => "ReducedVAT", _ => "" };
        var match = ledgerAccounts.FirstOrDefault(a => (a.DefaultVatPercentType ?? "") == wanted) ?? ledgerAccounts.FirstOrDefault();
        newLedgerId = match?.Id.ToString() ?? "";
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || creating) return;
        creating = true; createError = null;
        try
        {
            using var busy = Busy.Begin("Creating the product in Payday…");
            var result = await ProductsApi.CreateAsync(new PaydayProductCreate(
                newName.Trim(), newSku.Trim(), string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim(),
                newPrice, newVat, Guid.Parse(newLedgerId),
                newTrackStock, newTrackStock ? newOpeningQty : null, newTrackStock && newPurchasePrice > 0 ? newPurchasePrice : null,
                Enum.TryParse<PaydayProductRole>(newRole, out var role) ? role : PaydayProductRole.Unassigned,
                newUnit.Trim(), newCategory.Trim()));
            if (!result.IsSuccess || result.Value is null)
            {
                createError = result.ErrorMessage ?? "The product could not be created in Payday right now.";
                return;
            }
            showCreate = false;
            message = $"✓ {result.Value.Sku} — {result.Value.Name} created in Payday" + (role != PaydayProductRole.Unassigned ? $" as {RoleLabel(role)}." : ".");
            messageIsError = false;
            await LoadAsync();
        }
        finally
        {
            creating = false;
        }
    }
}
