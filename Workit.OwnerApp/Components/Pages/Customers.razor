@page "/customers"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICompanyApi CompanyApi
@inject ICustomersApi CustomersApi
@inject IPaydayCustomersApi PaydayCustomersApi
@inject IPaydayInvoicesApi PaydayInvoicesApi
@inject IJSRuntime JS

<PageTitle>Customers</PageTitle>

@* ── Header ── *@
<FluentCard Class="admin-card" AreaRestricted="false">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <FluentLabel Typo="Typography.PaneHeader">Customers</FluentLabel>
        @if (company is not null)
        {
            <FluentButton Appearance="Appearance.Accent" @onclick="ToggleCreateForm">
                @(showCreateForm ? "✕ Cancel" : "+ New")
            </FluentButton>
        }
    </div>

    @if (company is null && !loading)
    {
        <FluentLabel style="margin-top:0.5rem;">Set up the company first in Admin before adding customers.</FluentLabel>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@loadError</FluentLabel>
    }
</FluentCard>

@* ── Create form ── *@
@if (showCreateForm)
{
    <FluentCard Class="admin-card" AreaRestricted="false">
        <FluentLabel Typo="Typography.Body"><strong>New Customer</strong></FluentLabel>
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div>
                <FluentTextField Label="Name *" @bind-Value="newCustomerName" Placeholder="Customer name" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="SSN" @bind-Value="newCustomerSsn" Placeholder="SSN" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Email" @bind-Value="newCustomerEmail" Placeholder="Email" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Phone" @bind-Value="newCustomerPhone" Placeholder="Phone" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Contact person" @bind-Value="newCustomerContactPerson" Placeholder="Contact person" style="width:100%" />
            </div>
            <div class="plan-tasks">
                <FluentSwitch @bind-Value="newCustomerPlanJobsInTasks" Label="Plan jobs in tasks" />
                <span class="plan-tasks-hint">New jobs for this customer open with a Tasks section. Any job can still get tasks.</span>
            </div>
        </div>
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="CreateCustomerAsync">Save</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="ToggleCreateForm">Cancel</FluentButton>
        </div>
    </FluentCard>
}

@* ── Edit form ── *@
@if (editingCustomer is not null)
{
    <AppDialog Title="Edit Customer" OnClose="CancelCustomerEdit" Busy="savingEdit">
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div>
                <FluentTextField Label="Name *" @bind-Value="editingCustomer.Name" Placeholder="Customer name" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="SSN" @bind-Value="editingCustomer.Ssn" Placeholder="SSN" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Email" @bind-Value="editingCustomer.Email" Placeholder="Email" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Phone" @bind-Value="editingCustomer.Phone" Placeholder="Phone" style="width:100%" />
            </div>
            <div>
                <FluentTextField Label="Contact person" @bind-Value="editingCustomer.ContactPerson" Placeholder="Contact person" style="width:100%" />
            </div>
            <div class="plan-tasks">
                <FluentSwitch @bind-Value="editingCustomer.PlanJobsInTasks" Label="Plan jobs in tasks" />
                <span class="plan-tasks-hint">New jobs for this customer open with a Tasks section. Any job can still get tasks.</span>
            </div>
        </div>
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="SaveCustomerAsync" Disabled="@savingEdit">Save Changes</FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="CancelCustomerEdit" Disabled="@savingEdit">Cancel</FluentButton>
        </div>
        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <FluentLabel Color="Color.Error" role="alert">@loadError</FluentLabel>
        }
    </AppDialog>
}

@* ── List ── *@
<div class="cust-panel">
    <div class="cust-panel-header">
        <span class="cust-panel-title">All Customers</span>
        <span class="cust-count">@customers.Count</span>
    </div>

    @if (loading)
    {
        <PageLoader />
    }
    else if (customers.Count > 0)
    {
        <FluentDataGrid TGridItem="Customer" Items="@customers.AsQueryable()" AutoFit="true" DisplayMode="DataGridDisplayMode.Table">
            <PropertyColumn Property="@(x => x.Name)" Title="Name" />
            <PropertyColumn Property="@(x => x.Ssn)" Title="SSN" />
            <PropertyColumn Property="@(x => x.Email)" Title="Email" />
            <PropertyColumn Property="@(x => x.Phone)" Title="Phone" />
            <PropertyColumn Property="@(x => x.ContactPerson)" Title="Contact Person" />
            <TemplateColumn Title="Actions">
                <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => BeginEditCustomer(context))">Edit</FluentButton>
                @if (company?.HasPaydayCredentials == true)
                {
                    <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => OpenPaydayAsync(context))" title="Invoices and balance in Payday">Payday</FluentButton>
                }
            </TemplateColumn>
        </FluentDataGrid>
    }
    else
    {
        <FluentLabel>No customers yet.</FluentLabel>
    }
</div>

@* ── Payday: invoices and account statement for one customer ── *@
@if (paydayCustomer is not null)
{
    <AppDialog Title="@($"{paydayCustomer.Name} in Payday")" Wide="true" OnClose="@(() => paydayCustomer = null)" Busy="paydayLoading">
        @if (paydayLoading)
        {
            <div class="dialog-loading" role="status"><FluentProgressRing /> Loading from Payday…</div>
        }
        else if (paydayError is not null)
        {
            <FluentLabel Color="Color.Error">@paydayError</FluentLabel>
        }
        else if (paydayMatch is null)
        {
            <FluentLabel>
                No Payday customer matches <strong>@paydayCustomer.Name</strong>
                @(string.IsNullOrWhiteSpace(paydayCustomer.Ssn) ? "— add an SSN in Workit so it can be matched" : $"(SSN {paydayCustomer.Ssn})").
                Invoices built for this customer will create one.
            </FluentLabel>
        }
        else
        {
            var open = paydayInvoices.Where(i => i.Status == "SENT").ToList();
            var overdue = open.Where(i => i.FinalDueDate is { } fd && fd.Date < DateTime.Today).ToList();
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:0.75rem; margin-bottom:1rem;">
                <div style="padding:0.75rem 1rem; border-radius:10px; background:#eff6ff;">
                    <div style="font-size:0.72rem; letter-spacing:0.06em; text-transform:uppercase; color:#1e3a8a;">Outstanding</div>
                    <strong style="font-size:1.3rem;">@((paydayStatement?.EndBalance ?? paydayInvoiceSummary?.UnpaidAmount ?? 0).ToString("N0")) kr.</strong>
                    <div style="font-size:0.8rem; color:#60758b;">@open.Count open invoice@(open.Count == 1 ? "" : "s")@(overdue.Count > 0 ? $" · {overdue.Count} overdue" : "")</div>
                </div>
                <div style="padding:0.75rem 1rem; border-radius:10px; background:#ecfdf5;">
                    <div style="font-size:0.72rem; letter-spacing:0.06em; text-transform:uppercase; color:#065f46;">Paid</div>
                    <strong style="font-size:1.3rem;">@((paydayInvoiceSummary?.PaidAmount ?? 0).ToString("N0")) kr.</strong>
                    <div style="font-size:0.8rem; color:#60758b;">@paydayInvoices.Count(i => i.Status == "PAID") paid</div>
                </div>
                <div style="padding:0.75rem 1rem; border-radius:10px; background:#f8fafc;">
                    <div style="font-size:0.72rem; letter-spacing:0.06em; text-transform:uppercase; color:#425468;">Invoices</div>
                    <strong style="font-size:1.3rem;">@(paydayInvoiceSummary?.TotalCount ?? paydayInvoices.Count)</strong>
                    <div style="font-size:0.8rem; color:#60758b;">in Payday · @paydayMatch.Email</div>
                </div>
            </div>

            <FluentLabel Typo="Typography.Body" Style="font-weight:700; margin-bottom:0.25rem;">Invoices</FluentLabel>
            @if (paydayInvoices.Count == 0)
            {
                <FluentLabel Style="color:#60758b; margin-bottom:1rem;">No invoices yet.</FluentLabel>
            }
            else
            {
                <div style="overflow-x:auto; margin-bottom:1rem;">
                    <FluentDataGrid TGridItem="PaydayInvoice" Items="@paydayInvoices.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                        <TemplateColumn Title="#"><span>@(context.Number?.ToString() ?? "draft")</span></TemplateColumn>
                        <TemplateColumn Title="Date"><span>@context.InvoiceDate?.ToString("d MMM yyyy")</span></TemplateColumn>
                        <TemplateColumn Title="Final due">
                            <span style="@(context.Status == "SENT" && context.FinalDueDate is { } fd && fd.Date < DateTime.Today ? "color:#dc2626; font-weight:600;" : "")">@context.FinalDueDate?.ToString("d MMM yyyy")</span>
                        </TemplateColumn>
                        <PropertyColumn Property="@(i => i.Description)" Title="Description" />
                        <TemplateColumn Title="Amount" Align="Align.End"><span>@context.AmountIncludingVat.ToString("N0") kr.</span></TemplateColumn>
                        <TemplateColumn Title="Status"><span style="@StatusStyle(context.Status)">@context.Status</span></TemplateColumn>
                        <TemplateColumn Title="">
                            <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small" @onclick="@(() => OpenPdfAsync(context))" Disabled="@(pdfBusyId == context.Id)">PDF</FluentButton>
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            <FluentLabel Typo="Typography.Body" Style="font-weight:700; margin-bottom:0.25rem;">Account statement (last 12 months)</FluentLabel>
            @if (paydayStatement is null || paydayStatement.Lines.Count == 0)
            {
                <FluentLabel Style="color:#60758b;">No movements.</FluentLabel>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <FluentDataGrid TGridItem="PaydayAccountStatementLine" Items="@paydayStatement.Lines.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                        <TemplateColumn Title="Date"><span>@context.Date.ToString("d MMM yyyy")</span></TemplateColumn>
                        <PropertyColumn Property="@(l => l.Voucher)" Title="Voucher" />
                        <PropertyColumn Property="@(l => l.Description)" Title="Description" />
                        <TemplateColumn Title="Amount" Align="Align.End">
                            <span style="@(context.Amount < 0 ? "color:#047857;" : "")">@context.Amount.ToString("N0")</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Balance" Align="Align.End"><strong>@context.Balance.ToString("N0")</strong></TemplateColumn>
                    </FluentDataGrid>
                </div>
                <FluentLabel Style="font-size:0.85rem; color:#60758b; margin-top:0.5rem;">
                    Opening @paydayStatement.StartBalance.ToString("N0") kr. → closing <strong>@paydayStatement.EndBalance.ToString("N0") kr.</strong>
                </FluentLabel>
            }
        }
    </AppDialog>
}

@code {
    private readonly List<Customer> customers = [];
    private Company? company;
    private bool savingEdit;
    private Customer? editingCustomer;
    private bool loading = true;
    private bool showCreateForm;

    // ── Payday dialog state ──
    private Customer? paydayCustomer;
    private PaydayCustomer? paydayMatch;
    private PaydayInvoicesSummary? paydayInvoiceSummary;
    private List<PaydayInvoice> paydayInvoices = [];
    private PaydayAccountStatement? paydayStatement;
    private bool paydayLoading;
    private string? paydayError;
    private Guid pdfBusyId;

    private static string StatusStyle(string status) => status switch
    {
        "PAID"      => "background:#d1fae5; color:#065f46; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
        "SENT"      => "background:#dbeafe; color:#1e40af; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
        "CANCELLED" => "background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
        _           => "background:#f1f5f9; color:#475569; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
    };

    /// <summary>
    /// Finds the customer in Payday — by the stored PaydayId, else by SSN — and
    /// loads invoices and the last 12 months' statement. All three calls go to
    /// Payday, so this runs only when the owner opens the dialog.
    /// </summary>
    private async Task OpenPaydayAsync(Customer customer)
    {
        paydayCustomer = customer; paydayMatch = null; paydayInvoices = []; paydayStatement = null; paydayInvoiceSummary = null; paydayError = null;
        paydayLoading = true;
        try
        {
            if (customer.PaydayId is Guid pid)
            {
                var one = await PaydayCustomersApi.GetByIdAsync(pid.ToString());
                if (one.IsSuccess) paydayMatch = one.Value;
            }
            if (paydayMatch is null && !string.IsNullOrWhiteSpace(customer.Ssn))
            {
                var digits = new string(customer.Ssn.Where(char.IsDigit).ToArray());
                var all = await PaydayCustomersApi.GetAllAsync(1, 200);
                if (!all.IsSuccess) { paydayError = all.ErrorMessage; return; }
                paydayMatch = (all.Value?.Customers ?? []).FirstOrDefault(c => new string((c.Ssn ?? "").Where(char.IsDigit).ToArray()) == digits);
            }
            if (paydayMatch is null) return;

            var id = paydayMatch.Id.ToString();
            var invTask  = PaydayCustomersApi.GetInvoicesAsync(id, 1, 50);
            var stmtTask = PaydayCustomersApi.GetAccountStatementAsync(id, DateTime.Today.AddMonths(-12).ToString("yyyy-MM-dd"), DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"));
            // The list endpoint's summary carries paid/unpaid totals; the customer route has none.
            var sumTask  = PaydayInvoicesApi.GetAllAsync(page: 1, perPage: 1, include: null, customerId: paydayMatch.Id);
            await Task.WhenAll(invTask, stmtTask, sumTask);

            var inv = await invTask;
            if (!inv.IsSuccess) { paydayError = inv.ErrorMessage; return; }
            paydayInvoices = (inv.Value?.Invoices ?? []).OrderByDescending(i => i.Number ?? int.MaxValue).ToList();
            var stmt = await stmtTask;
            if (stmt.IsSuccess) paydayStatement = stmt.Value;
            var sum = await sumTask;
            if (sum.IsSuccess) paydayInvoiceSummary = sum.Value?.Summary;
        }
        finally { paydayLoading = false; }
    }

    private async Task OpenPdfAsync(PaydayInvoice invoice)
    {
        pdfBusyId = invoice.Id;
        try
        {
            var pdf = await PaydayInvoicesApi.GetPdfAsync(invoice.Id.ToString());
            if (pdf.IsSuccess && pdf.Value is { Length: > 0 } bytes)
                await JS.InvokeVoidAsync("triggerFileDownload", $"invoice-{invoice.Number?.ToString() ?? "draft"}.pdf", Convert.ToBase64String(bytes), "application/pdf");
            else paydayError = pdf.ErrorMessage ?? "The PDF could not be downloaded.";
        }
        finally { pdfBusyId = Guid.Empty; }
    }
    private string newCustomerName = string.Empty;
    private string newCustomerSsn = string.Empty;
    private string newCustomerEmail = string.Empty;
    private string newCustomerPhone = string.Empty;
    private string newCustomerContactPerson = string.Empty;
    private bool newCustomerPlanJobsInTasks;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading    = true;
        loadError  = null;
        customers.Clear();
        var companyResult = await CompanyApi.GetCompanyAsync();
        company = companyResult.Value;

        if (!companyResult.IsSuccess)
        {
            loadError = companyResult.ErrorMessage;
            loading = false;
            return;
        }

        if (company is null)
        {
            loading = false;
            return;
        }

        var customersResult = await CustomersApi.GetCustomersAsync();
        if (!customersResult.IsSuccess)
        {
            loadError = customersResult.ErrorMessage;
            loading = false;
            return;
        }

        customers.AddRange(customersResult.Value ?? []);
        loading = false;
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (!showCreateForm) ResetCreateForm();
    }

    private void ResetCreateForm()
    {
        newCustomerPlanJobsInTasks = false;
        newCustomerName = string.Empty;
        newCustomerSsn = string.Empty;
        newCustomerEmail = string.Empty;
        newCustomerPhone = string.Empty;
        newCustomerContactPerson = string.Empty;
    }

    private async Task CreateCustomerAsync()
    {
        if (company is null || string.IsNullOrWhiteSpace(newCustomerName))
        {
            return;
        }

        var result = await CustomersApi.CreateCustomerAsync(new Customer
        {
            CompanyId = company.Id,
            Name = newCustomerName.Trim(),
            Ssn = newCustomerSsn.Trim(),
            Email = newCustomerEmail.Trim(),
            Phone = newCustomerPhone.Trim(),
            ContactPerson = newCustomerContactPerson.Trim(),
            PlanJobsInTasks = newCustomerPlanJobsInTasks
        });

        if (result.IsSuccess)
        {
            ResetCreateForm();
            showCreateForm = false;
            await LoadAsync();
            return;
        }

        loadError = result.ErrorMessage;
    }

    private void BeginEditCustomer(Customer customer)
    {
        loadError = null;
        showCreateForm = false;
        editingCustomer = new Customer
        {
            Id = customer.Id,
            CompanyId = customer.CompanyId,
            Name = customer.Name,
            Ssn = customer.Ssn,
            Email = customer.Email,
            Phone = customer.Phone,
            ContactPerson = customer.ContactPerson
        };
    }

    private async Task SaveCustomerAsync()
    {
        if (editingCustomer is null || savingEdit)
        {
            return;
        }

        savingEdit = true;
        loadError = null;
        try
        {
            var result = await CustomersApi.UpdateCustomerAsync(editingCustomer);
            if (result.IsSuccess)
            {
                editingCustomer = null;
                await LoadAsync();
                return;
            }

            loadError = result.ErrorMessage;
        }
        finally
        {
            savingEdit = false;
        }
    }

    private void CancelCustomerEdit()
    {
        editingCustomer = null;
    }
}
