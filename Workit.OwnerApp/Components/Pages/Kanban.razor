@page "/kanban"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJobsApi JobsApi
@inject ITimeEntriesApi TimeEntriesApi
@inject ICustomersApi CustomersApi
@inject IJobTasksApi TasksApi
@inject IEmployeesApi EmployeesApi
@inject NavigationManager Nav

<PageTitle>Kanban</PageTitle>

@* ── Header ── *@
<FluentCard Class="admin-card" AreaRestricted="false">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <FluentLabel Typo="Typography.PaneHeader">Kanban</FluentLabel>
        <div style="display:flex; gap:0.5rem; align-items:center;">
            <div class="kanban-toggle" role="tablist">
                <button class="kanban-toggle-btn @(byTask ? "" : "kanban-toggle-btn--on")" @onclick="@(() => byTask = false)">By job</button>
                <button class="kanban-toggle-btn @(byTask ? "kanban-toggle-btn--on" : "")" @onclick="@(() => byTask = true)">By task <span class="kanban-toggle-n">@tasks.Count</span></button>
            </div>
            <span style="font-size:0.82rem; color:#6b7280;">@jobs.Count job@(jobs.Count == 1 ? "" : "s")</span>
            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" @onclick="LoadAsync" Disabled="@loading">
                Refresh
            </FluentButton>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@loadError</FluentLabel>
    }
    @if (!string.IsNullOrWhiteSpace(actionResult))
    {
        <FluentLabel Color="@(actionError ? Color.Error : Color.Success)" style="margin-top:0.5rem;">@actionResult</FluentLabel>
    }
</FluentCard>

@if (loading)
{
    <PageLoader />
}
else if (byTask)
{
    @* ── Task board: every task is a card; lanes come from hours and status ── *@
    <div class="kanban-board kanban-board--tasks">
        @foreach (var lane in TaskLanes)
        {
            var laneTasks = TasksIn(lane);
            <div class="kanban-lane">
                <div class="kanban-lane-header @TaskLaneClass(lane)">
                    <span class="kanban-lane-title">@TaskLaneTitle(lane)</span>
                    <span class="kanban-lane-count">@laneTasks.Count</span>
                </div>
                <div class="kanban-cards">
                    @if (laneTasks.Count == 0)
                    {
                        <div class="kanban-empty">@(lane == TaskLane.Todo && tasks.Count == 0 ? "No tasks yet — add them on a job" : "No tasks")</div>
                    }
                    @foreach (var task in laneTasks)
                    {
                        var job = jobById.GetValueOrDefault(task.JobId);
                        var hours = TaskHours(task.Id);
                        var over = task.EstimatedHours is decimal est && hours > est;
                        <div class="kanban-card kanban-card--clickable @(lane == TaskLane.Done ? "kanban-card--done" : "")" @onclick="@(() => Nav.NavigateTo($"/jobs/{task.JobId}"))">
                            <div class="kanban-card-code">@task.Code</div>
                            <div class="kanban-card-name">@task.Name</div>
                            <div class="kanban-card-customer">@(job?.Name ?? "—")@(job is not null ? $" · {customerLookup.GetValueOrDefault(job.CustomerId, "—")}" : "")</div>
                            <div class="kanban-card-meta">
                                <span class="@(over ? "kanban-over" : "")" title="@(task.EstimatedHours is decimal e2 ? $"Estimate {e2:0.#} h" : "No estimate")">
                                    @hours.ToString("0.#") h@(task.EstimatedHours is decimal e3 ? $" / {e3:0.#}" : "")
                                </span>
                                <span>@AssigneeNames(task)</span>
                            </div>
                            @if (lane == TaskLane.Done && task.DoneAt is DateTimeOffset doneAt)
                            {
                                <div class="kanban-card-timestamp kanban-card-timestamp--done">
                                    <span class="kanban-ts-label">Done</span>
                                    <span class="kanban-ts-value">@FormatDate(doneAt)</span>
                                </div>
                            }
                            <div class="kanban-card-actions" @onclick:stopPropagation="true">
                                @if (lane == TaskLane.Done)
                                {
                                    <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small" Disabled="@(busyTaskId == task.Id)" @onclick="@(() => ReopenTaskAsync(task))">Reopen</FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" Disabled="@(busyTaskId == task.Id)" @onclick="@(() => MarkTaskDoneAsync(task))">Done</FluentButton>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    @* ── Board ── *@
    <div class="kanban-board">

        @* BACKLOG *@
        <div class="kanban-lane">
            <div class="kanban-lane-header kanban-lane-header--backlog">
                <span class="kanban-lane-title">Backlog</span>
                <span class="kanban-lane-count">@BacklogJobs.Count</span>
            </div>
            <div class="kanban-cards">
                @if (BacklogJobs.Count == 0)
                {
                    <div class="kanban-empty">No jobs</div>
                }
                @foreach (var job in BacklogJobs)
                {
                    <div class="kanban-card kanban-card--clickable" @onclick="@(() => Nav.NavigateTo($"/jobs/{job.Id}"))">
                        <div class="kanban-card-code">@job.Code</div>
                        <div class="kanban-card-name">@job.Name</div>
                        <div class="kanban-card-customer">@customerLookup.GetValueOrDefault(job.CustomerId, "—")</div>
                        @TaskSummary(job)
                    </div>
                }
            </div>
        </div>

        @* IN PROGRESS *@
        <div class="kanban-lane">
            <div class="kanban-lane-header kanban-lane-header--inprogress">
                <span class="kanban-lane-title">In Progress</span>
                <span class="kanban-lane-count">@InProgressJobs.Count</span>
            </div>
            <div class="kanban-cards">
                @if (InProgressJobs.Count == 0)
                {
                    <div class="kanban-empty">No jobs</div>
                }
                @foreach (var job in InProgressJobs)
                {
                    <div class="kanban-card kanban-card--clickable" @onclick="@(() => Nav.NavigateTo($"/jobs/{job.Id}"))">
                        <div class="kanban-card-code">@job.Code</div>
                        <div class="kanban-card-name">@job.Name</div>
                        <div class="kanban-card-customer">@customerLookup.GetValueOrDefault(job.CustomerId, "—")</div>
                        @TaskSummary(job)
                        <div class="kanban-card-meta">
                            <span>@EntryCount(job.Id) entr@(EntryCount(job.Id) == 1 ? "y" : "ies")</span>
                            <span>@TotalHours(job.Id).ToString("0.#") h</span>
                        </div>
                        @if (job.KanbanInProgressAt.HasValue)
                        {
                            <div class="kanban-card-timestamp">
                                <span class="kanban-ts-label">Started</span>
                                <span class="kanban-ts-value">@FormatDate(job.KanbanInProgressAt.Value)</span>
                                <span class="kanban-ts-age">@AgeSince(job.KanbanInProgressAt.Value)</span>
                            </div>
                        }
                        <div class="kanban-card-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="Appearance.Outline" Size="ButtonSize.Small"
                                          @onclick="@(() => OpenWaitingSheet(job))">
                                Move to Waiting
                            </FluentButton>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* WAITING *@
        <div class="kanban-lane">
            <div class="kanban-lane-header kanban-lane-header--waiting">
                <span class="kanban-lane-title">Waiting</span>
                <span class="kanban-lane-count">@WaitingJobs.Count</span>
            </div>
            <div class="kanban-cards">
                @if (WaitingJobs.Count == 0)
                {
                    <div class="kanban-empty">No jobs</div>
                }
                @foreach (var job in WaitingJobs)
                {
                    <div class="kanban-card kanban-card--clickable" @onclick="@(() => Nav.NavigateTo($"/jobs/{job.Id}"))">
                        <div class="kanban-card-code">@job.Code</div>
                        <div class="kanban-card-name">@job.Name</div>
                        <div class="kanban-card-customer">@customerLookup.GetValueOrDefault(job.CustomerId, "—")</div>
                        @TaskSummary(job)
                        @if (!string.IsNullOrWhiteSpace(job.WaitingReason))
                        {
                            <div class="kanban-card-reason">@job.WaitingReason</div>
                        }
                        @if (job.KanbanInProgressAt.HasValue)
                        {
                            <div class="kanban-card-timestamp">
                                <span class="kanban-ts-label">Started</span>
                                <span class="kanban-ts-value">@FormatDate(job.KanbanInProgressAt.Value)</span>
                            </div>
                        }
                        @if (job.KanbanWaitingAt.HasValue)
                        {
                            <div class="kanban-card-timestamp kanban-card-timestamp--waiting">
                                <span class="kanban-ts-label">Waiting since</span>
                                <span class="kanban-ts-value">@FormatDate(job.KanbanWaitingAt.Value)</span>
                                <span class="kanban-ts-age">@AgeSince(job.KanbanWaitingAt.Value)</span>
                            </div>
                        }
                        <div class="kanban-card-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                                          @onclick="@(() => MoveToInProgressAsync(job))">
                                Resume
                            </FluentButton>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* DONE *@
        <div class="kanban-lane">
            <div class="kanban-lane-header kanban-lane-header--done">
                <span class="kanban-lane-title">Done</span>
                <span class="kanban-lane-count">@DoneJobs.Count</span>
            </div>
            <div class="kanban-cards">
                @if (DoneJobs.Count == 0)
                {
                    <div class="kanban-empty">No jobs</div>
                }
                @foreach (var job in DoneJobs)
                {
                    <div class="kanban-card kanban-card--done kanban-card--clickable" @onclick="@(() => Nav.NavigateTo($"/jobs/{job.Id}"))">
                        <div class="kanban-card-code">@job.Code</div>
                        <div class="kanban-card-name">@job.Name</div>
                        <div class="kanban-card-customer">@customerLookup.GetValueOrDefault(job.CustomerId, "—")</div>
                        @if (job.KanbanInProgressAt.HasValue)
                        {
                            <div class="kanban-card-timestamp">
                                <span class="kanban-ts-label">Started</span>
                                <span class="kanban-ts-value">@FormatDate(job.KanbanInProgressAt.Value)</span>
                            </div>
                        }
                        @if (job.KanbanDoneAt.HasValue)
                        {
                            <div class="kanban-card-timestamp kanban-card-timestamp--done">
                                <span class="kanban-ts-label">Invoiced</span>
                                <span class="kanban-ts-value">@FormatDate(job.KanbanDoneAt.Value)</span>
                            </div>
                        }
                        @if (job.KanbanInProgressAt.HasValue && job.KanbanDoneAt.HasValue)
                        {
                            <div class="kanban-card-cycletime">
                                Cycle time: <strong>@CycleTime(job.KanbanInProgressAt.Value, job.KanbanDoneAt.Value)</strong>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
}

@* ── Waiting reason sheet ── *@
@if (waitingJob is not null)
{
    <div class="kanban-sheet-backdrop" @onclick="CloseWaitingSheet"></div>
    <div class="kanban-sheet">
        <div class="kanban-sheet-handle"></div>
        <div class="kanban-sheet-title">Move to Waiting</div>
        <div class="kanban-sheet-subtitle">@waitingJob.Code — @waitingJob.Name</div>

        <div style="margin-top:1rem;">
            <FluentSelect Label="Reason" TValue="string" TOption="string" @bind-Value="waitingReason" style="width:100%">
                <FluentOption TOption="string" Value="Waiting on Material">Waiting on Material</FluentOption>
                <FluentOption TOption="string" Value="Waiting on Customer">Waiting on Customer</FluentOption>
                <FluentOption TOption="string" Value="Waiting on Vendor">Waiting on Vendor</FluentOption>
                <FluentOption TOption="string" Value="Other Reason">Other Reason</FluentOption>
            </FluentSelect>
        </div>

        @if (!string.IsNullOrWhiteSpace(sheetError))
        {
            <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@sheetError</FluentLabel>
        }

        <div style="display:flex; gap:0.5rem; margin-top:1rem;">
            <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmWaitingAsync" Disabled="@isSaving">
                @(isSaving ? "Saving…" : "Confirm")
            </FluentButton>
            <FluentButton Appearance="Appearance.Outline" @onclick="CloseWaitingSheet" Disabled="@isSaving">
                Cancel
            </FluentButton>
        </div>
    </div>
}

<style>
    .kanban-board {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 1rem;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .kanban-board {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 520px) {
        .kanban-board {
            grid-template-columns: 1fr;
        }
    }

    .kanban-lane {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .kanban-lane-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.85rem;
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .kanban-lane-header--backlog    { background: #f1f5f9; color: #475569; }
    .kanban-lane-header--inprogress { background: #eff6ff; color: #1d4ed8; }
    .kanban-lane-header--waiting    { background: #fffbeb; color: #b45309; }
    .kanban-lane-header--done       { background: #f0fdf4; color: #15803d; }

    .kanban-lane-count {
        background: rgba(0,0,0,0.08);
        border-radius: 99px;
        padding: 1px 7px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .kanban-cards {
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 60px;
    }

    .kanban-empty {
        font-size: 0.8rem;
        color: #9ca3af;
        text-align: center;
        padding: 0.75rem 0;
    }

    .kanban-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        padding: 0.65rem 0.75rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    .kanban-card--done {
        opacity: 0.75;
    }

    .kanban-card--clickable {
        cursor: pointer;
        transition: box-shadow 0.15s, border-color 0.15s;
    }

    .kanban-card--clickable:hover {
        border-color: #93c5fd;
        box-shadow: 0 2px 8px rgba(59,130,246,0.12);
    }

    .kanban-card-code {
        font-size: 0.72rem;
        font-weight: 700;
        color: #6b7280;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 0.15rem;
    }

    .kanban-card-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 0.2rem;
    }

    .kanban-card-customer {
        font-size: 0.78rem;
        color: #6b7280;
        margin-bottom: 0.3rem;
    }

    .kanban-card-meta {
        display: flex;
        gap: 0.5rem;
        font-size: 0.75rem;
        color: #9ca3af;
        margin-bottom: 0.35rem;
    }

    .kanban-card-reason {
        font-size: 0.78rem;
        color: #b45309;
        background: #fffbeb;
        border-radius: 4px;
        padding: 3px 6px;
        margin-bottom: 0.35rem;
        font-style: italic;
    }

    /* Timestamp rows */
    .kanban-card-timestamp {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.73rem;
        color: #6b7280;
        margin-bottom: 0.2rem;
    }

    .kanban-card-timestamp--waiting .kanban-ts-label { color: #b45309; }
    .kanban-card-timestamp--done    .kanban-ts-label { color: #15803d; }

    .kanban-ts-label {
        font-weight: 600;
        min-width: 4.5rem;
    }

    .kanban-ts-value {
        color: #374151;
    }

    .kanban-ts-age {
        margin-left: auto;
        color: #9ca3af;
        font-style: italic;
        white-space: nowrap;
    }

    .kanban-card-cycletime {
        font-size: 0.75rem;
        color: #15803d;
        background: #f0fdf4;
        border-radius: 4px;
        padding: 3px 6px;
        margin-top: 0.3rem;
    }

    .kanban-card-actions {
        margin-top: 0.5rem;
    }

    /* Sheet */
    .kanban-sheet-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 200;
    }

    .kanban-sheet {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(480px, calc(100vw - 2rem));
        background: #fff;
        border-radius: 12px;
        padding: 1.5rem;
        z-index: 201;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    }

    .kanban-sheet-handle {
        display: none;
    }

    .kanban-sheet-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 0.25rem;
    }

    .kanban-sheet-subtitle {
        font-size: 0.85rem;
        color: #6b7280;
    }

    /* View toggle */
    .kanban-toggle { display: inline-flex; border: 1px solid #d5dbe3; border-radius: 8px; overflow: hidden; }
    .kanban-toggle-btn { all: unset; cursor: pointer; padding: 0.3rem 0.75rem; font-size: 0.82rem; font-weight: 500; color: #475569; background: #fff; }
    .kanban-toggle-btn--on { background: #1f2f4d; color: #fff; }
    .kanban-toggle-n { opacity: 0.75; margin-left: 0.25rem; font-variant-numeric: tabular-nums; }

    /* Tasks on a job card */
    .kanban-tasks { margin-top: 0.5rem; border-top: 1px solid #f1f5f9; padding-top: 0.45rem; }
    .kanban-tasks-head { display: flex; justify-content: space-between; font-size: 0.75rem; color: #6b7280; margin-bottom: 0.3rem; }
    .kanban-tasks-bar { height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden; margin-bottom: 0.4rem; }
    .kanban-tasks-bar > span { display: block; height: 100%; background: #15803d; }
    .kanban-task { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; padding: 0.15rem 0; }
    .kanban-task-code { color: #6b7280; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .kanban-task-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kanban-task-hours { color: #6b7280; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .kanban-task-done { all: unset; cursor: pointer; width: 18px; height: 18px; border: 1.5px solid #cbd5e1; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; color: #15803d; }
    .kanban-task-done:hover { border-color: #15803d; background: #f0fdf4; }
    .kanban-task-more { font-size: 0.75rem; color: #6b7280; padding-top: 0.15rem; }
    .kanban-over { color: #b45309; font-weight: 600; }
    .kanban-lane-header--todo { background: #f1f5f9; color: #475569; }
    .kanban-board--tasks { grid-template-columns: repeat(3, 1fr); }
    @@media (max-width: 900px) { .kanban-board--tasks { grid-template-columns: 1fr; } }
</style>

@code {
    private bool    loading      = true;
    private string? loadError;
    private string  actionResult = string.Empty;
    private bool    actionError;
    private bool    isSaving;

    private List<Job>       jobs       = [];
    private List<TimeEntry> allEntries = [];
    private List<JobTask>   tasks      = [];
    private readonly Dictionary<Guid, string> customerLookup = new();
    private readonly Dictionary<Guid, string> employeeLookup = new();
    private readonly Dictionary<Guid, Job>    jobById        = new();
    private bool  byTask;
    private Guid? busyTaskId;

    // ── Tasks ─────────────────────────────────────────────────────────────────

    private enum TaskLane { Todo, InProgress, Done }
    private static readonly TaskLane[] TaskLanes = [TaskLane.Todo, TaskLane.InProgress, TaskLane.Done];

    private static string TaskLaneTitle(TaskLane lane) => lane switch { TaskLane.Todo => "To do", TaskLane.InProgress => "In progress", _ => "Done" };
    private static string TaskLaneClass(TaskLane lane) => lane switch { TaskLane.Todo => "kanban-lane-header--todo", TaskLane.InProgress => "kanban-lane-header--inprogress", _ => "kanban-lane-header--done" };

    /// <summary>Done is the task's own status; before that, hours logged on it mean it is under way.</summary>
    private TaskLane LaneOf(JobTask t) =>
        t.Status == JobTaskStatus.Done ? TaskLane.Done : TaskHours(t.Id) > 0 ? TaskLane.InProgress : TaskLane.Todo;

    private List<JobTask> TasksIn(TaskLane lane) => lane == TaskLane.Done
        ? tasks.Where(t => LaneOf(t) == lane).OrderByDescending(t => t.DoneAt).ToList()
        : tasks.Where(t => LaneOf(t) == lane).OrderBy(t => jobById.GetValueOrDefault(t.JobId)?.Code).ThenBy(t => t.SortOrder).ThenBy(t => t.TaskNumber).ToList();

    private decimal TaskHours(Guid taskId) => allEntries.Where(e => e.TaskId == taskId).Sum(e => e.Hours + e.OvertimeHours);

    private List<JobTask> TasksOf(Guid jobId) => tasks.Where(t => t.JobId == jobId).OrderBy(t => t.SortOrder).ThenBy(t => t.TaskNumber).ToList();

    private string AssigneeNames(JobTask t) => t.AssignedEmployeeIds.Count == 0
        ? "Job's crew"
        : string.Join(", ", t.AssignedEmployeeIds.Select(id => employeeLookup.GetValueOrDefault(id, "?")));

    /// <summary>Progress bar plus the open tasks, each with a ✓ — only on jobs that have tasks.</summary>
    private RenderFragment TaskSummary(Job job) => __builder =>
    {
        var all = TasksOf(job.Id);
        if (all.Count == 0) return;
        var done = all.Count(t => t.Status == JobTaskStatus.Done);
        var open = all.Where(t => t.Status != JobTaskStatus.Done).ToList();
        const int show = 4;
        <div class="kanban-tasks" @onclick:stopPropagation="true">
            <div class="kanban-tasks-head"><span>Tasks</span><span>@done / @all.Count done</span></div>
            <div class="kanban-tasks-bar"><span style="width:@(all.Count == 0 ? 0 : done * 100 / all.Count)%"></span></div>
            @foreach (var t in open.Take(show))
            {
                var h = TaskHours(t.Id);
                <div class="kanban-task">
                    <button class="kanban-task-done" title="Mark @t.Code done" disabled="@(busyTaskId == t.Id)" @onclick="@(() => MarkTaskDoneAsync(t))">@(busyTaskId == t.Id ? "…" : "")</button>
                    <span class="kanban-task-code">@t.Code</span>
                    <span class="kanban-task-name" title="@t.Name">@t.Name</span>
                    @if (h > 0)
                    {
                        <span class="kanban-task-hours @(t.EstimatedHours is decimal est && h > est ? "kanban-over" : "")">@h.ToString("0.#") h</span>
                    }
                </div>
            }
            @if (open.Count > show)
            {
                <div class="kanban-task-more">+ @(open.Count - show) more</div>
            }
        </div>
    };

    private async Task MarkTaskDoneAsync(JobTask task)
    {
        if (busyTaskId is not null) return;
        busyTaskId = task.Id; actionResult = string.Empty;
        var result = await TasksApi.MarkDoneAsync(task.Id);
        if (result.IsSuccess && result.Value is { } saved)
        {
            task.Status = saved.Status; task.DoneAt = saved.DoneAt; task.DoneByUserId = saved.DoneByUserId;
            actionError = false; actionResult = $"{task.Code} done.";
        }
        else { actionError = true; actionResult = result.ErrorMessage ?? "Could not mark the task done."; }
        busyTaskId = null;
    }

    private async Task ReopenTaskAsync(JobTask task)
    {
        if (busyTaskId is not null) return;
        busyTaskId = task.Id; actionResult = string.Empty;
        var result = await TasksApi.ReopenAsync(task.Id);
        if (result.IsSuccess && result.Value is { } saved)
        {
            task.Status = saved.Status; task.DoneAt = saved.DoneAt; task.DoneByUserId = saved.DoneByUserId;
            actionError = false; actionResult = $"{task.Code} reopened.";
        }
        else { actionError = true; actionResult = result.ErrorMessage ?? "Could not reopen the task."; }
        busyTaskId = null;
    }

    // Waiting sheet state
    private Job?   waitingJob;
    private string waitingReason = string.Empty;
    private string sheetError    = string.Empty;

    // ── Lane derivation ────────────────────────────────────────────────────────

    private List<Job> BacklogJobs    => jobs.Where(j => GetLane(j) == Lane.Backlog).ToList();
    private List<Job> InProgressJobs => jobs.Where(j => GetLane(j) == Lane.InProgress).ToList();
    private List<Job> WaitingJobs    => jobs.Where(j => GetLane(j) == Lane.Waiting).ToList();
    private List<Job> DoneJobs       => jobs.Where(j => GetLane(j) == Lane.Done).OrderByDescending(j => j.KanbanDoneAt).ToList();

    private enum Lane { Backlog, InProgress, Waiting, Done }

    private Lane GetLane(Job job)
    {
        var entries = allEntries.Where(e => e.JobId == job.Id).ToList();
        if (entries.Count == 0)                        return Lane.Backlog;
        if (entries.All(e => e.IsInvoiced))            return Lane.Done;
        if (job.KanbanStatus == KanbanStatus.Waiting)  return Lane.Waiting;
        return Lane.InProgress;
    }

    private int     EntryCount(Guid jobId) => allEntries.Count(e => e.JobId == jobId);
    private decimal TotalHours(Guid jobId) => allEntries.Where(e => e.JobId == jobId).Sum(e => e.Hours);

    // ── Timestamp helpers ──────────────────────────────────────────────────────

    private static string FormatDate(DateTimeOffset ts) =>
        ts.ToLocalTime().ToString("dd MMM yyyy");

    private static string AgeSince(DateTimeOffset ts)
    {
        var days = (DateTimeOffset.UtcNow - ts).TotalDays;
        if (days < 1)  return "today";
        if (days < 2)  return "1 day";
        if (days < 7)  return $"{(int)days} days";
        if (days < 14) return "1 week";
        if (days < 30) return $"{(int)(days / 7)} weeks";
        if (days < 60) return "1 month";
        return $"{(int)(days / 30)} months";
    }

    private static string CycleTime(DateTimeOffset start, DateTimeOffset end)
    {
        var days = (end - start).TotalDays;
        if (days < 1)  return "under 1 day";
        if (days < 2)  return "1 day";
        if (days < 7)  return $"{(int)days} days";
        if (days < 14) return "1 week";
        if (days < 30) return $"{(int)(days / 7)} weeks";
        if (days < 60) return "1 month";
        return $"{(int)(days / 30)} months";
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading      = true;
        loadError    = null;
        actionResult = string.Empty;
        jobs.Clear();
        allEntries.Clear();
        tasks.Clear();
        customerLookup.Clear();
        employeeLookup.Clear();
        jobById.Clear();

        var jobsTask    = JobsApi.GetJobsAsync();
        var entriesTask = TimeEntriesApi.GetTimeEntriesAsync();
        var custTask    = CustomersApi.GetCustomersAsync();
        var tasksTask   = TasksApi.GetTasksAsync();
        var empTask     = EmployeesApi.GetEmployeesAsync();
        await Task.WhenAll(jobsTask, entriesTask, custTask, tasksTask, empTask);

        var tasksResult = await tasksTask;
        var empResult   = await empTask;
        if (tasksResult.IsSuccess) tasks.AddRange(tasksResult.Value ?? []);
        foreach (var e in empResult.Value ?? []) employeeLookup[e.Id] = e.DisplayName;

        var jobsResult    = await jobsTask;
        var entriesResult = await entriesTask;
        var custResult    = await custTask;

        if (!jobsResult.IsSuccess)    { loadError = jobsResult.ErrorMessage;    loading = false; return; }
        if (!entriesResult.IsSuccess) { loadError = entriesResult.ErrorMessage; loading = false; return; }

        jobs.AddRange(jobsResult.Value ?? []);
        allEntries.AddRange(entriesResult.Value ?? []);
        foreach (var j in jobs) jobById[j.Id] = j;

        foreach (var c in custResult.Value ?? [])
            customerLookup[c.Id] = c.Name;

        loading = false;
    }

    // ── Actions ────────────────────────────────────────────────────────────────

    private void OpenWaitingSheet(Job job)
    {
        waitingJob    = job;
        waitingReason = job.WaitingReason ?? "Waiting on Material";
        sheetError    = string.Empty;
        actionResult  = string.Empty;
    }

    private void CloseWaitingSheet() => waitingJob = null;

    private async Task ConfirmWaitingAsync()
    {
        if (waitingJob is null) return;
        isSaving   = true;
        sheetError = string.Empty;

        var result = await JobsApi.UpdateKanbanStatusAsync(waitingJob.Id, KanbanStatus.Waiting, waitingReason.Trim());
        if (result.IsSuccess)
        {
            var job = jobs.First(j => j.Id == waitingJob.Id);
            job.KanbanStatus   = KanbanStatus.Waiting;
            job.WaitingReason  = string.IsNullOrWhiteSpace(waitingReason) ? null : waitingReason.Trim();
            job.KanbanWaitingAt = DateTimeOffset.UtcNow;
            actionError  = false;
            actionResult = $"{job.Code} moved to Waiting.";
            waitingJob   = null;
        }
        else
        {
            sheetError = result.ErrorMessage ?? "Could not update job status.";
        }

        isSaving = false;
    }

    private async Task MoveToInProgressAsync(Job job)
    {
        actionResult = string.Empty;
        var result = await JobsApi.UpdateKanbanStatusAsync(job.Id, KanbanStatus.Active, null);
        if (result.IsSuccess)
        {
            job.KanbanStatus   = KanbanStatus.Active;
            job.WaitingReason  = null;
            job.KanbanWaitingAt = null;
            actionError  = false;
            actionResult = $"{job.Code} resumed.";
        }
        else
        {
            actionError  = true;
            actionResult = result.ErrorMessage ?? "Could not update job status.";
        }
    }
}
