@page "/materials"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IMaterialsApi MaterialsApi
@inject IPaydayProductsCacheApi PaydayProducts
@inject ICompanyApi CompanyApi
@inject BusyService Busy
@inject NavigationManager Nav

<PageTitle>Materials</PageTitle>

@* ── Header ── *@
<FluentCard Class="admin-card" AreaRestricted="false">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <div>
            <FluentLabel Typo="Typography.PaneHeader">Materials</FluentLabel>
            @if (Managed)
            {
                <FluentLabel Style="color:#60758b; margin-top:0.25rem;">
                    Managed in Payday — this list mirrors your Payday products with the Material role and refreshes every half hour.
                    Add, change or archive products in Payday; stock moves when invoices are issued.
                </FluentLabel>
            }
        </div>
        @if (Managed)
        {
            <FluentButton Appearance="Appearance.Outline" @onclick="@(() => Nav.NavigateTo("/payday/products"))">Payday → Products</FluentButton>
        }
        else
        {
            <FluentButton Appearance="Appearance.Accent" @onclick="ToggleCreateForm">
                @(showCreateForm ? "✕ Cancel" : "+ New")
            </FluentButton>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <FluentLabel Color="Color.Error" style="margin-top:0.5rem;">@loadError</FluentLabel>
    }
</FluentCard>

@* ── Switch-over to Payday products ── *@
@if (!loading && !Managed && company?.HasPaydayCredentials == true)
{
    <FluentCard Class="admin-card" AreaRestricted="false" Style="border-left:4px solid #1d6fb8;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;">
            <div style="max-width:60ch;">
                <FluentLabel Typo="Typography.Body" Style="font-weight:700;">Move materials to Payday</FluentLabel>
                <FluentLabel Style="color:#60758b; font-size:0.9rem; margin-top:0.25rem;">
                    One list instead of two: each material becomes (or is linked to) a Payday product by its product code, with today's
                    stock as the opening balance. From then on Payday holds the prices and the stock, and this page only shows them.
                    Preview first — nothing changes until you switch over.
                </FluentLabel>
            </div>
            <div style="display:flex; gap:0.5rem;">
                <FluentButton Appearance="Appearance.Outline" @onclick="@(() => RunMigrationAsync(dryRun: true))">Preview</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="@(() => confirmSwitch = true)" Disabled="@(migration is null || migration.Conflicts > 0)">Switch over</FluentButton>
            </div>
        </div>
        @if (migration is not null)
        {
            <FluentLabel Style="margin-top:0.75rem; font-size:0.9rem;">
                <strong>@migration.Linked</strong> will be linked to existing Payday products ·
                <strong>@migration.Created</strong> will be created in Payday ·
                <strong>@migration.AlreadyLinked</strong> already linked ·
                <strong style="@(migration.Conflicts > 0 ? "color:#b91c1c;" : "")">@migration.Conflicts</strong> @(migration.Conflicts == 1 ? "conflict" : "conflicts")
            </FluentLabel>
            @if (migration.Conflicts > 0)
            {
                <FluentLabel Style="color:#b91c1c; font-size:0.85rem;">Fix the conflicts below and preview again; the switch is only offered when there are none.</FluentLabel>
            }
            <div style="overflow-x:auto; margin-top:0.5rem;">
                <FluentDataGrid TGridItem="MaterialsMigrationRow" Items="@migration.Rows.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                    <TemplateColumn Title="Material"><span>@context.Name</span></TemplateColumn>
                    <TemplateColumn Title="Code"><span style="font-family:monospace;">@context.ProductCode</span></TemplateColumn>
                    <TemplateColumn Title="Action">
                        <span style="@ActionStyle(context.Action)">@ActionLabel(context.Action)</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Payday SKU"><span style="font-family:monospace;">@context.Sku</span></TemplateColumn>
                    <PropertyColumn Property="@(r => r.Message)" Title="" />
                </FluentDataGrid>
            </div>
        }
    </FluentCard>
}

@if (confirmSwitch)
{
    <AppDialog Title="Switch materials to Payday?" OnClose="@(() => confirmSwitch = false)" Busy="migrating">
        <p style="margin:0 0 0.75rem;">
            <strong>@migration?.Created</strong> product@(migration?.Created == 1 ? "" : "s") will be created in Payday and
            <strong>@migration?.Linked</strong> linked. After this, materials are added and changed in Payday, and stock moves when invoices are issued.
        </p>
        <p style="margin:0; color:#60758b; font-size:0.9rem;">This is a one-time switch for the company.</p>
        <div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1.25rem;">
            <FluentButton Appearance="Appearance.Outline" @onclick="@(() => confirmSwitch = false)" Disabled="@migrating">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="@(() => RunMigrationAsync(dryRun: false))" Disabled="@migrating">Switch over</FluentButton>
        </div>
    </AppDialog>
}

@* ── Add / Edit form ── *@
@if (showCreateForm || editingMaterial is not null)
{
    <AppDialog Title="@(editingMaterial is not null ? "Edit Material" : "New Material")" OnClose="CancelEdit" Busy="saving">
        <div class="admin-grid" style="margin-top:0.75rem;">
            <div>
                <FluentTextField Label="Name *" @bind-Value="formName" Placeholder="e.g. N1XE-U 5G 16 Cu 1kV Aflstrengur" style="width:100%" />
            </div>

            <div>
                <FluentTextField Label="Product code" @bind-Value="formCode" Placeholder="e.g. N1XECU015G016" style="width:100%" />
            </div>

            <div>
                <FluentSelect Label="Category *" TValue="string" TOption="string" @bind-Value="formCategory" style="width:100%">
                    @foreach (var cat in Categories)
                    {
                        <FluentOption TOption="string" Value="@cat">@cat</FluentOption>
                    }
                </FluentSelect>
            </div>

            <div>
                <FluentSelect Label="Unit" TValue="string" TOption="string" @bind-Value="formUnit" style="width:100%">
                    @foreach (var u in Units)
                    {
                        <FluentOption TOption="string" Value="@u">@u</FluentOption>
                    }
                </FluentSelect>
            </div>

            <div>
                <FluentNumberField Label="Purchase price (ex. VAT)" TValue="decimal" @bind-Value="formPurchasePrice" Min="0" Step="0.01" style="width:100%"
                                   @bind-Value:after="RecalcSalePrice" Placeholder="What you pay the vendor" />
            </div>

            <div>
                <FluentNumberField Label="Markup factor" TValue="decimal" @bind-Value="formMarkupFactor" Min="1" Step="0.05" style="width:100%"
                                   @bind-Value:after="RecalcSalePrice" Placeholder="e.g. 1.5 = 50% markup" />
            </div>

            <div>
                <FluentNumberField Label="Sale price (ex. VAT)" TValue="decimal" @bind-Value="formUnitPrice" Min="0" Step="0.01" style="width:100%" />
                @if (formPurchasePrice > 0 && formMarkupFactor > 0)
                {
                    <span style="font-size:0.82rem; color:#60758b; margin-top:0.2rem; display:block;">
                        Auto-calc: @((formPurchasePrice * formMarkupFactor).ToString("N0")) kr.
                    </span>
                }
            </div>

            <div>
                <FluentNumberField Label="VAT rate (%)" TValue="decimal" @bind-Value="formVatRate" Min="0" Max="100" Step="0.5" style="width:100%" />
            </div>

            <div>
                <FluentNumberField Label="Quantity in stock" TValue="decimal" @bind-Value="formQuantity" Min="0" Step="1" style="width:100%"
                                   Placeholder="e.g. 500 (metres of cable)" />
            </div>

            <div style="grid-column: span 2">
                <FluentTextField Label="Description" @bind-Value="formDescription" Placeholder="Optional notes" style="width:100%" />
            </div>

            @* The Payday product this material bills as. Payday's price/VAT win on
               the invoice; the fields above stay for reference and stock display. *@
            <div style="grid-column: span 2">
                <FluentSelect Label="Payday product" TValue="string" TOption="string" @bind-Value="formPaydayProductId" style="width:100%">
                    <FluentOption TOption="string" Value="">— Not linked —</FluentOption>
                    @foreach (var p in paydayMaterials)
                    {
                        <FluentOption TOption="string" Value="@p.PaydayId.ToString()">@p.Sku — @p.Name (@p.SalePriceExVat.ToString("N0") kr.)</FluentOption>
                    }
                </FluentSelect>
                @if (paydayMaterials.Count == 0)
                {
                    <FluentLabel Style="color:#60758b; font-size:0.8rem; margin-top:0.25rem;">
                        No Payday products with the Material role yet — <a href="/payday/products">sync and assign roles</a> first.
                    </FluentLabel>
                }
            </div>
        </div>
        <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
            @if (editingMaterial is not null)
            {
                <FluentButton Appearance="Appearance.Accent" @onclick="UpdateMaterialAsync"
                              Disabled="@(string.IsNullOrWhiteSpace(formName) || saving)">
                    @(saving ? "Saving…" : "Save changes")
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit" Disabled="@saving">Cancel</FluentButton>
            }
            else
            {
                <FluentButton Appearance="Appearance.Accent" @onclick="CreateMaterialAsync"
                              Disabled="@(string.IsNullOrWhiteSpace(formName) || saving)">
                    @(saving ? "Saving…" : "Save")
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit" Disabled="@saving">Cancel</FluentButton>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(saveResult))
        {
            <FluentLabel style="margin-top:0.25rem;">@saveResult</FluentLabel>
        }
    </AppDialog>
}

@* ── Category filter + grid ── *@
<div class="mat-panel">
    <div class="mat-panel-header">
        <span class="mat-panel-title">Material Catalog</span>
        <span class="mat-count">@filteredMaterials.Count</span>
    </div>

    <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
        <FluentLabel>Category:</FluentLabel>
        <FluentSelect TValue="string" TOption="string" @bind-Value="filterCategory"
                      @bind-Value:after="ApplyFilter" style="min-width:180px">
            <FluentOption TOption="string" Value="">All</FluentOption>
            @foreach (var cat in Categories)
            {
                <FluentOption TOption="string" Value="@cat">@cat</FluentOption>
            }
        </FluentSelect>
    </div>

    @if (loading)
    {
        <PageLoader />
    }
    else if (filteredMaterials.Count > 0)
    {
        <div style="overflow-x:auto; margin-top:0.25rem;">
            <FluentDataGrid TGridItem="Material" Items="@filteredMaterials.AsQueryable()"
                            DisplayMode="DataGridDisplayMode.Table" style="min-width:1100px;">
                <PropertyColumn Property="@(x => x.Category)"    Title="Category" />
                <PropertyColumn Property="@(x => x.Name)"        Title="Name" />
                <PropertyColumn Property="@(x => x.ProductCode)" Title="Code" />
                <PropertyColumn Property="@(x => x.Unit)"        Title="Unit" />
                <TemplateColumn Title="Purchase">
                    <span>@(context.PurchasePrice > 0 ? $"{context.PurchasePrice:N0} kr." : "—")</span>
                </TemplateColumn>
                <TemplateColumn Title="Markup">
                    <span>@(context.MarkupFactor != 1m ? $"{context.MarkupFactor:0.##}×" : "—")</span>
                </TemplateColumn>
                <TemplateColumn Title="Sale (ex. VAT)">
                    <span>@context.UnitPrice.ToString("N0") kr.</span>
                </TemplateColumn>
                <TemplateColumn Title="Incl. VAT">
                    <span>@((context.UnitPrice * (1 + context.VatRate / 100m)).ToString("N0")) kr.</span>
                </TemplateColumn>
                <PropertyColumn Property="@(x => x.VatRate)"     Title="VAT %" Format="0.#" />
                <TemplateColumn Title="In stock">
                    @{
                        var stockStyle = context.Quantity <= 0
                            ? "color:#dc2626; font-weight:600;"
                            : context.Quantity < 10
                                ? "color:#d97706; font-weight:600;"
                                : "color:#059669; font-weight:600;";
                    }
                    <span style="@stockStyle">@context.Quantity.ToString("0.##") @context.Unit</span>
                    @if (context.UninvoicedQuantity > 0)
                    {
                        <div style="font-size:0.75rem; color:#b45309;" title="Logged on jobs but not yet invoiced — Payday's stock still includes it">@context.UninvoicedQuantity.ToString("0.##") not invoiced</div>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Payday">
                    @{
                        var linked = LinkedProduct(context);
                    }
                    @if (linked is not null)
                    {
                        <span title="@linked.Name" style="font-family:monospace; font-size:0.85rem; color:#1d6fb8;">@linked.Sku</span>
                    }
                    else
                    {
                        <span style="color:#b45309; font-size:0.85rem;">@(context.PaydayProductId is null ? "not linked" : "unknown product")</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Status">
                    @{
                        var statusStyle = context.IsActive
                            ? "background:#d1fae5; color:#065f46; padding:2px 10px; border-radius:4px; font-size:0.8rem; font-weight:600;"
                            : "background:#fee2e2; color:#991b1b; padding:2px 10px; border-radius:4px; font-size:0.8rem; font-weight:600;";
                    }
                    <span style="@statusStyle">@(context.IsActive ? "Active" : "Inactive")</span>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    @if (Managed)
                    {
                        <span style="color:#9ca3af; font-size:0.85rem;">in Payday</span>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Stealth" @onclick="@(() => BeginEdit(context))">Edit</FluentButton>
                        <FluentButton Appearance="Appearance.Stealth"
                                      style="color: var(--error);"
                                      @onclick="@(() => DeleteMaterialAsync(context))">Delete</FluentButton>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
    else
    {
        <FluentLabel>No materials yet. Add the first one above.</FluentLabel>
    }
</div>

@code {
    // ── Static lists ───────────────────────────────────────────────────────────
    private static readonly string[] Categories =
    [
        "Rafstrengir",
        "Lagnaefni",
        "Lagnaleiðir",
        "Töflubúnaður",
        "Stýribúnaður",
        "Fjarskiptabúnaður",
        "Hitabúnaður",
        "Lýsing",
        "Rofa- og tenglaefni",
        "Verkfæri",
        "Tengibúnaður",
        "Veitubúnaður",
        "Hleðsla rafbíla",
        "Dyrasímar",
        "Snjalllausnir",
        "Brunavarnir",
        "Annað"
    ];

    private static readonly string[] Units = ["stk.", "m.", "pk.", "rúll.", "box", "kg", "ltr."];

    // ── State ──────────────────────────────────────────────────────────────────
    private bool loading = true;
    private bool showCreateForm;
    private List<Material> allMaterials     = [];
    private List<Material> filteredMaterials = [];
    private Material?      editingMaterial;

    private string  filterCategory  = string.Empty;
    private string  loadError       = string.Empty;
    private string  saveResult      = string.Empty;
    private bool    saving;

    // ── Form fields ────────────────────────────────────────────────────────────
    private string  formName          = string.Empty;
    private string  formCode          = string.Empty;
    private string  formPaydayProductId = string.Empty;
    private Company? company;
    private bool Managed => company?.MaterialsManagedInPayday == true;
    private MaterialsMigrationResult? migration;
    private bool confirmSwitch;
    private bool migrating;

    private static string ActionLabel(MaterialsMigrationAction a) => a switch
    {
        MaterialsMigrationAction.Link => "Link", MaterialsMigrationAction.Create => "Create in Payday",
        MaterialsMigrationAction.AlreadyLinked => "Already linked", MaterialsMigrationAction.Conflict => "Conflict", _ => a.ToString(),
    };
    private static string ActionStyle(MaterialsMigrationAction a) => a switch
    {
        MaterialsMigrationAction.Conflict => "background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
        MaterialsMigrationAction.Create   => "background:#dbeafe; color:#1e40af; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
        _                                 => "background:#d1fae5; color:#065f46; padding:2px 8px; border-radius:4px; font-size:0.78rem; font-weight:600;",
    };

    private async Task RunMigrationAsync(bool dryRun)
    {
        migrating = true; loadError = string.Empty;
        try
        {
            using var busy = Busy.Begin(dryRun ? "Comparing materials with Payday…" : "Moving materials to Payday…");
            var result = await PaydayProducts.MigrateMaterialsAsync(dryRun);
            if (!result.IsSuccess || result.Value is null) { loadError = result.ErrorMessage ?? "The migration could not be run."; return; }
            migration = result.Value;
            if (!dryRun)
            {
                confirmSwitch = false;
                if (migration.SwitchedOver) { migration = null; await LoadAsync(); }   // page re-renders as managed
                else loadError = "Some materials could not be moved; see the conflicts. The company was not switched over.";
            }
        }
        finally { migrating = false; }
    }
    private readonly List<PaydayProductCache> paydayMaterials = [];
    private readonly Dictionary<Guid, PaydayProductCache> paydayBySku = [];
    private string  formCategory      = Categories[0];
    private string  formUnit          = "stk.";
    private decimal formPurchasePrice;
    private decimal formMarkupFactor  = 1.5m;
    private decimal formUnitPrice;
    private decimal formVatRate       = 24.0m;
    private decimal formQuantity;
    private string  formDescription   = string.Empty;
    private bool    formIsActive      = true;

    private void RecalcSalePrice()
    {
        if (formPurchasePrice > 0 && formMarkupFactor >= 1m)
            formUnitPrice = Math.Round(formPurchasePrice * formMarkupFactor, 0);
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        loadError = string.Empty;
        var productsTask = PaydayProducts.GetProductsAsync(includeArchived: true);
        var companyTask  = CompanyApi.GetCompanyAsync();
        var result = await MaterialsApi.GetMaterialsAsync();
        var cr = await companyTask;
        if (cr.IsSuccess) company = cr.Value;
        if (result.IsSuccess)
        {
            allMaterials = result.Value!;
            ApplyFilter();
        }
        else
        {
            loadError = result.ErrorMessage ?? "Could not load materials.";
        }
        // The cache is what the picker offers; only Material-role products, and
        // never archived ones, but the lookup keeps everything so an old link still shows.
        var products = await productsTask;
        paydayMaterials.Clear(); paydayBySku.Clear();
        foreach (var p in products.Value ?? [])
        {
            paydayBySku[p.PaydayId] = p;
            if (!p.Archived && p.Role == PaydayProductRole.Material) paydayMaterials.Add(p);
        }
        loading = false;
    }

    private void ApplyFilter()
    {
        filteredMaterials = string.IsNullOrWhiteSpace(filterCategory)
            ? [.. allMaterials]
            : [.. allMaterials.Where(m => m.Category == filterCategory)];
    }

    private void ToggleCreateForm() => showCreateForm = !showCreateForm;

    // ── CRUD ───────────────────────────────────────────────────────────────────
    private async Task CreateMaterialAsync()
    {
        saving     = true;
        saveResult = string.Empty;

        var material = new Material
        {
            Name          = formName,
            ProductCode   = formCode,
            Category      = formCategory,
            Unit          = formUnit,
            PurchasePrice = formPurchasePrice,
            MarkupFactor  = formMarkupFactor,
            UnitPrice     = formUnitPrice,
            VatRate       = formVatRate,
            Quantity      = formQuantity,
            Description   = formDescription,
            IsActive      = true,
            PaydayProductId = Guid.TryParse(formPaydayProductId, out var newLinkedId) ? newLinkedId : null
        };

        var result = await MaterialsApi.CreateMaterialAsync(material);
        if (result.IsSuccess)
        {
            saveResult = $"✓ {result.Value!.Name} added to catalog.";
            showCreateForm = false;
            ResetForm();
            await LoadAsync();
        }
        else
        {
            saveResult = result.ErrorMessage ?? "Could not save material.";
        }

        saving = false;
    }

    private void BeginEdit(Material m)
    {
        editingMaterial   = m;
        formName          = m.Name;
        formCode          = m.ProductCode;
        formPaydayProductId = m.PaydayProductId?.ToString() ?? string.Empty;
        formCategory      = m.Category;
        formUnit          = m.Unit;
        formPurchasePrice = m.PurchasePrice;
        formMarkupFactor  = m.MarkupFactor > 0 ? m.MarkupFactor : 1.5m;
        formUnitPrice     = m.UnitPrice;
        formVatRate       = m.VatRate;
        formQuantity      = m.Quantity;
        formDescription   = m.Description;
        formIsActive      = m.IsActive;
        saveResult        = string.Empty;
    }

    private async Task UpdateMaterialAsync()
    {
        if (editingMaterial is null) return;
        saving     = true;
        saveResult = string.Empty;

        var updated = new Material
        {
            Id            = editingMaterial.Id,
            CompanyId     = editingMaterial.CompanyId,
            CreatedAt     = editingMaterial.CreatedAt,
            Name          = formName,
            ProductCode   = formCode,
            Category      = formCategory,
            Unit          = formUnit,
            PurchasePrice = formPurchasePrice,
            MarkupFactor  = formMarkupFactor,
            UnitPrice     = formUnitPrice,
            VatRate       = formVatRate,
            Quantity      = formQuantity,
            Description   = formDescription,
            IsActive      = formIsActive,
            PaydayProductId = Guid.TryParse(formPaydayProductId, out var linkedId) ? linkedId : null
        };

        var result = await MaterialsApi.UpdateMaterialAsync(updated.Id, updated);
        if (result.IsSuccess)
        {
            saveResult = $"✓ {result.Value!.Name} updated.";
            editingMaterial = null;
            ResetForm();
            await LoadAsync();
        }
        else
        {
            saveResult = result.ErrorMessage ?? "Could not update material.";
        }

        saving = false;
    }

    private async Task DeleteMaterialAsync(Material m)
    {
        saveResult = string.Empty;
        var result = await MaterialsApi.DeleteMaterialAsync(m.Id);
        if (result.IsSuccess)
        {
            saveResult = $"✓ {m.Name} removed.";
            await LoadAsync();
        }
        else
        {
            saveResult = result.ErrorMessage ?? "Could not delete material.";
        }
    }

    private void CancelEdit()
    {
        showCreateForm = false;
        editingMaterial = null;
        ResetForm();
    }

    private PaydayProductCache? LinkedProduct(Material m) =>
        m.PaydayProductId is Guid id && paydayBySku.TryGetValue(id, out var p) ? p : null;

    private void ResetForm()
    {
        formName          = string.Empty;
        formCode          = string.Empty;
        formPaydayProductId = string.Empty;
        formCategory      = Categories[0];
        formUnit          = "stk.";
        formPurchasePrice = 0m;
        formMarkupFactor  = 1.5m;
        formUnitPrice     = 0m;
        formVatRate       = 24.0m;
        formQuantity      = 0m;
        formDescription   = string.Empty;
        formIsActive      = true;
    }
}
